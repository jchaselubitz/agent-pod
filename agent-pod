#!/usr/bin/env bash
#
# agent-pod — run an AI coding-agent CLI inside a throwaway Docker container
# that can only see the current project directory.
#
# Supported agents: claude, codex, opencode, cursor (built-in), plus any custom
# agents you define in ~/.agent-pod/.agent-pod.env.
#
# Only $PWD is mounted in by default. Per-agent auth/history is persisted on the
# host under ~/.agent-pod/<agent>. Everything else (your home dir, SSH keys,
# other projects) stays invisible to the agent unless explicitly allowlisted.
#
# NOTE: outbound network access inside the container is NOT restricted.

set -eo pipefail

CONTAINER_HOME="/home/agent-pod"
CONTAINER_NPM_PREFIX="$CONTAINER_HOME/.npm-global"
CONTAINER_PATH="$CONTAINER_NPM_PREFIX/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
MANAGED_LABEL="com.agent-pod.managed=true"

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  LINK_TARGET="$(readlink "$SOURCE")"
  case "$LINK_TARGET" in
    /*) SOURCE="$LINK_TARGET";;
    *) SOURCE="$SOURCE_DIR/$LINK_TARGET";;
  esac
done
LAUNCHER_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Where AgentPod keeps its own per-user state and config. This lives with the
# CLI (one stable location per user), not in whatever directory you happen to
# run from. AGENT_POD_HOME must be a real environment variable to relocate it,
# since we need it before any env-file is loaded.
CONFIG_HOME="${AGENT_POD_HOME:-$HOME/.agent-pod}"
CONFIG_ENV_FILE="$CONFIG_HOME/.agent-pod.env"

# ---- pretty output (auto-disabled when stderr is not a TTY) ---------------
if [ -t 2 ]; then
  C_INFO=$'\033[34m'; C_OK=$'\033[32m'; C_ERR=$'\033[31m'; C_DIM=$'\033[2m'; C_OFF=$'\033[0m'
else
  C_INFO=""; C_OK=""; C_ERR=""; C_DIM=""; C_OFF=""
fi
info() { printf '%s%s%s\n' "$C_INFO" "$*" "$C_OFF" >&2; }
ok()   { printf '%s%s%s\n' "$C_OK"   "$*" "$C_OFF" >&2; }
warn() { printf '%s%s%s\n' "$C_DIM"  "$*" "$C_OFF" >&2; }
die()  { printf '%s%s%s\n' "$C_ERR"  "$*" "$C_OFF" >&2; exit 1; }

discover_env_file() {
  # Resolution order, most to least specific:
  #   1. AGENT_POD_ENV_FILE        explicit override
  #   2. ~/.agent-pod/.agent-pod.env  central config that lives with the CLI
  #   3. cwd .agent-pod.env / agent-pod.env   legacy project-local files
  #   4. launcher-dir files                    legacy source-checkout files
  if [ -n "${AGENT_POD_ENV_FILE:-}" ]; then
    printf '%s\n' "$AGENT_POD_ENV_FILE"
  elif [ -f "$CONFIG_ENV_FILE" ]; then
    printf '%s\n' "$CONFIG_ENV_FILE"
  elif [ -f ".agent-pod.env" ]; then
    printf '%s\n' ".agent-pod.env"
  elif [ -f "agent-pod.env" ]; then
    printf '%s\n' "agent-pod.env"
  elif [ -f "$LAUNCHER_DIR/.agent-pod.env" ]; then
    printf '%s\n' "$LAUNCHER_DIR/.agent-pod.env"
  elif [ -f "$LAUNCHER_DIR/agent-pod.env" ]; then
    printf '%s\n' "$LAUNCHER_DIR/agent-pod.env"
  fi
}

dotenv_get() {
  key="$1"
  file="${2:-}"
  [ -n "$file" ] && [ -f "$file" ] || return 1
  awk -v key="$key" '
    /^[[:space:]]*(#|$)/ { next }
    {
      line=$0
      sub(/^[[:space:]]*export[[:space:]]+/, "", line)
      split(line, parts, "=")
      k=parts[1]
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", k)
      if (k == key) {
        sub(/^[^=]*=/, "", line)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
        if (line ~ /^".*"$/ || line ~ /^'\''.*'\''$/) {
          line=substr(line, 2, length(line)-2)
        }
        print line
        found=1
      }
    }
    END { exit found ? 0 : 1 }
  ' "$file"
}

config_value() {
  key="$1"
  default_value="${2:-}"
  if [ -n "${!key+x}" ]; then
    printf '%s\n' "${!key}"
  elif value="$(dotenv_get "$key" "$ENV_FILE" 2>/dev/null)"; then
    printf '%s\n' "$value"
  else
    printf '%s\n' "$default_value"
  fi
}

truthy() {
  case "$1" in
    1|true|TRUE|yes|YES|y|Y|on|ON) return 0;;
    *) return 1;;
  esac
}

# The Overlord CLI requires an http:// or https:// URL. Users often omit the scheme
# when pointing at host.docker.internal:4310 from inside a pod.
normalize_overlord_backend_url() {
  url="${1:-}"
  [ -z "$url" ] && return 0
  case "$url" in
    http://*|https://*) printf '%s\n' "$url";;
    *) printf 'http://%s\n' "$url";;
  esac
}

# Shell fragment run inside the pod before the agent starts. When
# OVERLORD_BACKEND_URL is forwarded into the container, write ~/.ovld/overlord.toml
# via `ovld config set` so `ovld protocol` and related commands target the
# configured backend. OVERLORD_USER_TOKEN is also honored at runtime by the
# Overlord CLI; we attempt `ovld auth login --token` so credentials persist in
# the bind-mounted HOME when the backend is reachable. Bootstrap commands must
# never inherit the launcher's stdin: some CLI versions prompt even with their
# nominally non-interactive flags, and those invisible prompts would otherwise
# consume input before the requested agent or shell starts.
overlord_in_pod_bootstrap_fragment() {
  printf '%s' \
    'if command -v ovld >/dev/null 2>&1; then ' \
    'backend_url="${OVERLORD_BACKEND_URL:-}"; ' \
    'user_token="${OVERLORD_USER_TOKEN:-${OVLD_USER_TOKEN:-}}"; ' \
    'if [ -n "$backend_url" ]; then ' \
    'case "$backend_url" in http://*|https://*) ;; *) backend_url="http://${backend_url}";; esac; ' \
    'export OVERLORD_BACKEND_URL="$backend_url"; ' \
    'case "$backend_url" in ' \
    '*://127.0.0.1:*|*://127.0.0.1|*://localhost:*|*://localhost|*://host.docker.internal:*|*://host.docker.internal) ' \
    'ovld config set local "$backend_url" </dev/null >/dev/null 2>&1 || true;; ' \
    '*) ovld config set cloud "$backend_url" </dev/null >/dev/null 2>&1 || true;; esac; ' \
    'if [ -n "$user_token" ]; then ovld auth login --token "$user_token" </dev/null >/dev/null 2>&1 || true; fi; ' \
    'fi; fi; '
}

nonnegative_integer() {
  case "$1" in
    ""|*[!0-9]*) return 1;;
    *) return 0;;
  esac
}

builtin_agents() {
  printf '%s\n' "claude codex opencode cursor agent"
}

# Backward-compatible alias used in prompts and help text.
available_agents() {
  builtin_agents
}

valid_agent_id() {
  case "$1" in
    [a-z][a-z0-9_-]*) return 0;;
    *) return 1;;
  esac
}

is_builtin_agent() {
  case "$1" in
    claude|codex|opencode|cursor|agent) return 0;;
    *) return 1;;
  esac
}

agent_env_key() {
  printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_'
}

agent_label() {
  local agent="$1"
  case "$agent" in
    claude) printf '%s\n' "Claude Code";;
    codex) printf '%s\n' "OpenAI Codex";;
    opencode) printf '%s\n' "OpenCode";;
    cursor) printf '%s\n' "Cursor Agent (agent alias)";;
    agent) printf '%s\n' "Cursor Agent";;
    *) printf '%s\n' "$agent";;
  esac
}

custom_agent_bin() {
  local agent="$1"
  local key
  key="$(agent_env_key "$agent")"
  config_value "AGENT_POD_${key}_BIN" ""
}

custom_agent_flags() {
  local agent="$1"
  local key
  key="$(agent_env_key "$agent")"
  config_value "AGENT_POD_${key}_FLAGS" ""
}

custom_agent_npm() {
  local agent="$1"
  local key
  key="$(agent_env_key "$agent")"
  config_value "AGENT_POD_${key}_NPM" ""
}

write_custom_agent_config() {
  local env_file="$1"
  local agent="$2"
  local bin="$3"
  local flags="$4"
  local npm_pkg="$5"
  local key
  key="$(agent_env_key "$agent")"
  upsert_env_var "$env_file" "AGENT_POD_${key}_BIN" "$bin"
  if [ -n "$flags" ]; then
    upsert_env_var "$env_file" "AGENT_POD_${key}_FLAGS" "$flags"
  fi
  if [ -n "$npm_pkg" ]; then
    upsert_env_var "$env_file" "AGENT_POD_${key}_NPM" "$npm_pkg"
  fi
}

# Sets global BIN and YOLO for the requested agent.
resolve_agent_launch() {
  local agent="$1"
  YOLO=()

  case "$agent" in
    claude)   BIN="claude";       YOLO=(--dangerously-skip-permissions);;
    codex)    BIN="codex";        YOLO=(--dangerously-bypass-approvals-and-sandbox);;
    opencode) BIN="opencode";     YOLO=();;
    cursor)   BIN="agent";        YOLO=(--force);;
    agent)    BIN="agent";        YOLO=(--force);;
    shell)    BIN="bash";         YOLO=(); return 0;;
    *)
      key="$(agent_env_key "$agent")"
      BIN="$(custom_agent_bin "$agent")"
      [ -n "$BIN" ] || die "Custom agent '$agent' has no AGENT_POD_${key}_BIN set. Add it with: agent-pod agent-add $agent --bin <cli>"
      flags="$(custom_agent_flags "$agent")"
      if [ -n "$flags" ]; then
        # shellcheck disable=SC2206
        YOLO=($flags)
      fi
      ;;
  esac

  [ "$(config_value AGENT_POD_YOLO 1)" = "0" ] && YOLO=()
  case "$agent" in
    claude) truthy "$(config_value AGENT_POD_CLAUDE_AUTO_FLAGS 1)" || YOLO=();;
    codex) truthy "$(config_value AGENT_POD_CODEX_AUTO_FLAGS 1)" || YOLO=();;
    cursor|agent) truthy "$(config_value AGENT_POD_CURSOR_AUTO_FLAGS 1)" || YOLO=();;
  esac
}

normalize_agents() {
  local raw normalized agent
  raw="$*"
  [ -n "$raw" ] || return 1
  normalized=""
  for agent in $(printf '%s\n' "$raw" | tr '[:upper:],;' '[:lower:]  '); do
    case "$agent" in
      all) printf '%s\n' "$(builtin_agents)"; return 0;;
      overlord) continue;;
      *)
        valid_agent_id "$agent" || return 1
        ;;
    esac
    case " $normalized " in
      *" $agent "*) ;;
      *) normalized="${normalized:+$normalized }$agent";;
    esac
  done
  [ -n "$normalized" ] || return 1
  printf '%s\n' "$normalized"
}

agents_csv() {
  printf '%s\n' "$*" | tr ' ' ','
}

agent_in_list() {
  local needle agent
  needle="$1"; shift
  for agent in "$@"; do
    [ "$agent" = "$needle" ] && return 0
  done
  return 1
}

supported_agents() {
  normalize_agents "$(config_value AGENT_POD_AGENTS "$(builtin_agents)")" \
    || die "Invalid AGENT_POD_AGENTS value. Use built-in agents ($(builtin_agents)) or custom agent IDs (lowercase letters, numbers, hyphens, underscores)."
}

upsert_env_var() {
  local file="$1"
  local key="$2"
  local value="$3"
  local tmp
  tmp="${file}.tmp.$$"
  if [ -f "$file" ] && grep -Eq "^[[:space:]]*(export[[:space:]]+)?${key}=" "$file"; then
    awk -v key="$key" -v value="$value" '
      BEGIN { done=0 }
      $0 ~ "^[[:space:]]*(export[[:space:]]+)?" key "=" {
        if (!done) {
          print key "=" value
          done=1
        }
        next
      }
      { print }
    ' "$file" > "$tmp"
  else
    [ -f "$file" ] && cp "$file" "$tmp" || : > "$tmp"
    printf '%s=%s\n' "$key" "$value" >> "$tmp"
  fi
  mv "$tmp" "$file"
}

prompt_yes_no() {
  prompt="$1"
  default="$2"
  [ -t 0 ] || { [ "$default" = "yes" ]; return; }
  if [ "$default" = "yes" ]; then suffix="[Y/n]"; else suffix="[y/N]"; fi
  while true; do
    printf '%s %s ' "$prompt" "$suffix" >&2
    read -r reply
    case "$reply" in
      "") [ "$default" = "yes" ] && return 0 || return 1;;
      y|Y|yes|YES) return 0;;
      n|N|no|NO) return 1;;
      *) warn "Please answer yes or no.";;
    esac
  done
}

prompt_text() {
  prompt="$1"
  [ -t 0 ] || return 1
  printf '%s ' "$prompt" >&2
  read -r reply
  printf '%s\n' "$reply"
}

prompt_agent_selection() {
  [ -t 0 ] || { builtin_agents; return 0; }
  if prompt_yes_no "Support all built-in agents? ($(builtin_agents))" "yes"; then
    builtin_agents
    return 0
  fi
  while true; do
    reply="$(prompt_text "Agents to support (space/comma separated; built-in: $(builtin_agents), or custom IDs like gemini):" || true)"
    if normalized="$(normalize_agents "$reply" 2>/dev/null)"; then
      printf '%s\n' "$normalized"
      return 0
    fi
    warn "Use built-in agents ($(builtin_agents)) or custom IDs (lowercase, e.g. gemini, my-harness)."
  done
}

prompt_custom_agents() {
  env_file="$1"
  current_agents="$2"
  next_agents="$current_agents"

  [ -t 0 ] || return 0
  if ! prompt_yes_no "Add custom agents or harnesses? (any CLI you want to run in the sandbox)" "no"; then
    printf '%s\n' "$next_agents"
    return 0
  fi

  if ! grep -q "Custom agent definitions" "$env_file" 2>/dev/null; then
    cat >> "$env_file" <<'EOF'

# Custom agent definitions (one block per agent).
# AGENT_POD_<ID>_BIN   CLI binary to run inside the container (required)
# AGENT_POD_<ID>_FLAGS space-separated default flags (optional)
# AGENT_POD_<ID>_NPM   npm package to bake into the image (optional)
EOF
  fi

  while true; do
    name="$(prompt_text "Custom agent name (blank to finish, e.g. gemini or my-harness):" || true)"
    [ -n "$name" ] || break
    name="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')"
    if ! valid_agent_id "$name"; then
      warn "Invalid name '$name'. Use lowercase letters, numbers, hyphens, or underscores."
      continue
    fi
    if is_builtin_agent "$name"; then
      warn "'$name' is a built-in agent — add it in the previous step instead."
      continue
    fi
    bin="$(prompt_text "CLI binary to run (e.g. gemini, my-harness-cli):" || true)"
    [ -n "$bin" ] || { warn "Binary is required for custom agents."; continue; }
    flags="$(prompt_text "Default flags (optional, e.g. --force or --dangerously-skip-permissions):" || true)"
    npm_pkg="$(prompt_text "npm package to install in image (optional, e.g. @google/gemini-cli):" || true)"
    write_custom_agent_config "$env_file" "$name" "$bin" "$flags" "$npm_pkg"
    if ! agent_in_list "$name" $next_agents; then
      next_agents="${next_agents:+$next_agents }$name"
    fi
    ok "Added custom agent '$name' (binary: $bin${flags:+; flags: $flags}${npm_pkg:+; npm: $npm_pkg})"
  done

  printf '%s\n' "$next_agents"
}

open_in_editor() {
  file="$1"
  if [ -n "${VISUAL:-}" ]; then
    "$VISUAL" "$file" || return 1
  elif [ -n "${EDITOR:-}" ]; then
    "$EDITOR" "$file" || return 1
  elif command -v code >/dev/null 2>&1; then
    code "$file" || return 1
  elif command -v cursor >/dev/null 2>&1; then
    cursor "$file" || return 1
  elif command -v open >/dev/null 2>&1; then
    open "$file" || return 1
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$file" || return 1
  else
    return 1
  fi
}

read_package_version() {
  version_file="$LAUNCHER_DIR/package.json"
  [ -f "$version_file" ] || die "Version unavailable: $version_file not found"
  if command -v node >/dev/null 2>&1; then
    node -e "process.stdout.write(require(process.argv[1]).version)" "$version_file"
    return 0
  fi
  version="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$version_file" | head -1)"
  [ -n "$version" ] || die "Could not read version from $version_file"
  printf '%s' "$version"
}

run_version() {
  [ $# -eq 0 ] || die "Usage: agent-pod version"
  printf '%s\n' "$(read_package_version)"
}

run_update() {
  info "Updating agent-pod-cli to the latest version..."
  if command -v npm >/dev/null 2>&1; then
    npm install -g agent-pod-cli@latest
    ok "agent-pod updated successfully."
  else
    die "npm is not installed or not on PATH. Install Node.js/npm and retry."
  fi
}

run_update_image() {
  [ $# -eq 0 ] || die "Usage: agent-pod update-image"
  info "Updating image '$IMAGE' with fresh CLI and package installs..."
  info "Per-agent auth and history under $STATE_ROOT are preserved."
  AGENT_POD_REFRESH_IMAGE=1 exec "$LAUNCHER_DIR/install.sh"
}

run_edit_env() {
  # Open the active env file in the user's editor. Creates the file (and its
  # parent directory) if it doesn't exist yet.
  target="${ENV_FILE:-$CONFIG_ENV_FILE}"
  mkdir -p "$(dirname "$target")" 2>/dev/null || true
  if [ ! -f "$target" ]; then
    : > "$target"
    chmod 600 "$target" 2>/dev/null || true
    ok "Created $target"
  fi
  if open_in_editor "$target"; then
    ok "Opened $target"
  else
    die "Could not open an editor automatically. Edit this file manually: $target"
  fi
}

run_prune() {
  [ $# -le 1 ] || die "Usage: agent-pod prune [hours]"
  until_hours="${1:-$(config_value AGENT_POD_PRUNE_UNTIL_HOURS 24)}"
  nonnegative_integer "$until_hours" \
    || die "Invalid prune age '$until_hours'. Use whole hours, or 0 for all stopped AgentPod containers."

  command -v docker >/dev/null 2>&1 || die "Docker is not installed or not on PATH."
  docker info >/dev/null 2>&1       || die "Docker daemon is not running. Start Docker and retry."

  PRUNE_FILTERS=(--filter "label=$MANAGED_LABEL")
  if [ "$until_hours" -gt 0 ]; then
    PRUNE_FILTERS+=(--filter "until=${until_hours}h")
  fi

  if [ "$until_hours" -eq 0 ]; then
    info "Pruning all stopped AgentPod containers..."
  else
    info "Pruning stopped AgentPod containers older than ${until_hours}h..."
  fi
  docker container prune --force "${PRUNE_FILTERS[@]}"
}

auto_prune_if_due() {
  truthy "$(config_value AGENT_POD_AUTO_PRUNE 1)" || return 0

  interval_hours="$(config_value AGENT_POD_PRUNE_INTERVAL_HOURS 24)"
  nonnegative_integer "$interval_hours" \
    || { warn "Invalid AGENT_POD_PRUNE_INTERVAL_HOURS='$interval_hours'; skipping auto-prune."; return 0; }

  marker="$STATE_ROOT/.last-container-prune"
  if [ -f "$marker" ] && [ "$interval_hours" -gt 0 ]; then
    interval_minutes=$((interval_hours * 60))
    if ! find "$marker" -mmin "+$interval_minutes" -print -quit 2>/dev/null | grep -q .; then
      return 0
    fi
  fi

  mkdir -p "$STATE_ROOT" 2>/dev/null || true
  if run_prune "$(config_value AGENT_POD_PRUNE_UNTIL_HOURS 24)" >/dev/null 2>&1; then
    touch "$marker" 2>/dev/null || true
  else
    warn "Automatic AgentPod container prune failed; continuing launch."
  fi
}

ensure_config_file() {
  target="${AGENT_POD_ENV_FILE:-$CONFIG_ENV_FILE}"
  mkdir -p "$(dirname "$target")" 2>/dev/null || true
  if [ ! -f "$target" ]; then
    : > "$target"
    chmod 600 "$target" 2>/dev/null || true
    ok "Created $target"
  fi
  printf '%s\n' "$target"
}

run_agents_list() {
  enabled="$(supported_agents)"
  info "Supported agents:"
  for agent in $enabled; do
    if is_builtin_agent "$agent"; then
      printf '  %-12s %s\n' "$agent" "$(agent_label "$agent")"
    else
      bin="$(custom_agent_bin "$agent")"
      flags="$(custom_agent_flags "$agent")"
      npm_pkg="$(custom_agent_npm "$agent")"
      detail="custom"
      [ -n "$bin" ] && detail="$detail; bin=$bin"
      [ -n "$flags" ] && detail="$detail; flags=$flags"
      [ -n "$npm_pkg" ] && detail="$detail; npm=$npm_pkg"
      printf '  %-12s %s\n' "$agent" "$detail"
    fi
  done
}

run_agent_add() {
  custom_bin=""
  custom_flags=""
  custom_npm=""
  agent_args=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --bin)
        custom_bin="${2:-}"
        shift 2
        ;;
      --flags)
        custom_flags="${2:-}"
        shift 2
        ;;
      --npm)
        custom_npm="${2:-}"
        shift 2
        ;;
      --) shift; agent_args+=("$@"); break;;
      -*) die "Unknown option '$1'. Custom agents accept --bin, --flags, and --npm.";;
      *) agent_args+=("$1"); shift;;
    esac
  done

  [ ${#agent_args[@]} -ge 1 ] || die "Usage: agent-pod agent-add <agent> [agent...] [--bin <cli>] [--flags \"<flags>\"] [--npm <package>]"

  add_agents="$(normalize_agents "${agent_args[@]}" 2>/dev/null)" \
    || die "Invalid agent ID. Use built-in agents ($(builtin_agents)) or custom IDs (lowercase, e.g. gemini)."

  current_agents="$(supported_agents)"
  next_agents="$current_agents"
  env_file="$(ensure_config_file)"

  for agent in $add_agents; do
    if is_builtin_agent "$agent"; then
      if ! agent_in_list "$agent" $next_agents; then
        next_agents="${next_agents:+$next_agents }$agent"
      fi
      continue
    fi
    bin="$custom_bin"
    if [ -z "$bin" ]; then
      bin="$(custom_agent_bin "$agent")"
    fi
    [ -n "$bin" ] || die "Custom agent '$agent' requires --bin <cli>. Example: agent-pod agent-add $agent --bin my-cli --flags \"--force\""
    flags="$custom_flags"
    [ -n "$flags" ] || flags="$(custom_agent_flags "$agent")"
    npm_pkg="$custom_npm"
    [ -n "$npm_pkg" ] || npm_pkg="$(custom_agent_npm "$agent")"
    write_custom_agent_config "$env_file" "$agent" "$bin" "$flags" "$npm_pkg"
    if ! agent_in_list "$agent" $next_agents; then
      next_agents="${next_agents:+$next_agents }$agent"
    fi
  done

  upsert_env_var "$env_file" AGENT_POD_AGENTS "$(agents_csv "$next_agents")"
  ok "Supported agents: $next_agents"
  info "Rebuild the image to install newly enabled CLIs: agent-pod update-image"
}

run_agent_remove() {
  [ $# -ge 1 ] || die "Usage: agent-pod agent-remove <agent> [agent...]"
  remove_agents="$(normalize_agents "$*" 2>/dev/null)" \
    || die "Invalid agent ID."
  current_agents="$(supported_agents)"
  next_agents=""
  for agent in $current_agents; do
    if agent_in_list "$agent" $remove_agents; then
      continue
    fi
    next_agents="${next_agents:+$next_agents }$agent"
  done
  [ -n "$next_agents" ] || die "At least one agent must remain supported."
  env_file="$(ensure_config_file)"
  upsert_env_var "$env_file" AGENT_POD_AGENTS "$(agents_csv "$next_agents")"
  ok "Supported agents: $next_agents"
  info "Rebuild the image to remove disabled CLIs: agent-pod update-image"
}

package_config_key() {
  # Map a package type to the env-file key that holds its package list.
  case "$1" in
    npm) printf '%s\n' "AGENT_POD_NPM_PACKAGES";;
    apt) printf '%s\n' "AGENT_POD_APT_PACKAGES";;
    *) return 1;;
  esac
}

valid_package_token() {
  # Package lists are split into individual package tokens at build time, so
  # reject anything that isn't a plausible package spec and disallow leading
  # dashes to prevent install-option injection.
  case "$1" in
    ""|-*|*[!A-Za-z0-9@._/+~^=-]*) return 1;;
    *) return 0;;
  esac
}

run_packages_list() {
  [ $# -eq 0 ] || die "Usage: agent-pod packages"
  npm_pkgs="$(config_value AGENT_POD_NPM_PACKAGES "")"
  apt_pkgs="$(config_value AGENT_POD_APT_PACKAGES "")"
  info "Custom packages baked into the image:"
  printf '  %-4s %s\n' "npm" "${npm_pkgs:-(none)}"
  printf '  %-4s %s\n' "apt" "${apt_pkgs:-(none)}"
  if [ -n "$npm_pkgs$apt_pkgs" ]; then
    info "Rebuild the image to apply changes: agent-pod install-image"
  fi
}

run_package_add() {
  pkg_type="npm"
  case "${1:-}" in
    --npm) shift;;
    --apt) pkg_type="apt"; shift;;
    --*) die "Unknown option '$1'. Use --npm (default) or --apt.";;
  esac
  [ $# -ge 1 ] || die "Usage: agent-pod package-add [--npm|--apt] <package> [package...]"
  key="$(package_config_key "$pkg_type")"
  for pkg in "$@"; do
    valid_package_token "$pkg" || die "Invalid package name: '$pkg'"
  done
  next="$(config_value "$key" "")"
  for pkg in "$@"; do
    case " $next " in
      *" $pkg "*) ;;
      *) next="${next:+$next }$pkg";;
    esac
  done
  env_file="$(ensure_config_file)"
  upsert_env_var "$env_file" "$key" "$next"
  ok "Custom $pkg_type packages: ${next:-(none)}"
  info "Rebuild the image to install them: agent-pod install-image"
}

run_package_remove() {
  pkg_type="npm"
  case "${1:-}" in
    --npm) shift;;
    --apt) pkg_type="apt"; shift;;
    --*) die "Unknown option '$1'. Use --npm (default) or --apt.";;
  esac
  [ $# -ge 1 ] || die "Usage: agent-pod package-remove [--npm|--apt] <package> [package...]"
  key="$(package_config_key "$pkg_type")"
  current="$(config_value "$key" "")"
  next=""
  for existing in $current; do
    drop=0
    for pkg in "$@"; do
      [ "$existing" = "$pkg" ] && { drop=1; break; }
    done
    [ "$drop" -eq 1 ] && continue
    next="${next:+$next }$existing"
  done
  env_file="$(ensure_config_file)"
  upsert_env_var "$env_file" "$key" "$next"
  ok "Custom $pkg_type packages: ${next:-(none)}"
  info "Rebuild the image to apply the change: agent-pod install-image"
}

trim_whitespace() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# Allowed-path entries are an absolute path optionally suffixed with ":ro" or
# ":rw" (":rw" is the default and rarely needs to be written explicitly).
allowed_path_entry_path() {
  case "$1" in
    *:ro) printf '%s\n' "${1%:ro}";;
    *:rw) printf '%s\n' "${1%:rw}";;
    *) printf '%s\n' "$1";;
  esac
}

allowed_path_entry_mode() {
  case "$1" in
    *:ro) printf 'ro\n';;
    *) printf 'rw\n';;
  esac
}

# Matches by the path portion only, so a list can't carry the same path twice
# under different modes.
path_in_csv_list() {
  local needle="$1"
  local list="$2"
  local existing
  OLDIFS="$IFS"; IFS=','
  for existing in $list; do
    IFS="$OLDIFS"
    [ "$(allowed_path_entry_path "$existing")" = "$needle" ] && return 0
    OLDIFS="$IFS"; IFS=','
  done
  IFS="$OLDIFS"
  return 1
}

valid_allowed_path() {
  local path
  path="$(allowed_path_entry_path "$1")"
  case "$path" in
    /*) ;;
    *) return 1;;
  esac
  case "$path" in
    *","*) return 1;;
  esac
  [ -e "$path" ] || return 1
  return 0
}

# Project-local allowlist file: committed to the repo (unlike .agent-pod.env,
# which is gitignored) so a team can share required paths via version control.
# One entry per line, "#" starts a comment, optional ":ro"/":rw" suffix.
project_paths_file() {
  printf '%s\n' ".agent-pod-allowed-paths"
}

# Entries from the project file, trimmed and stripped of comments/blanks.
read_project_paths_file() {
  local file content
  file="$(project_paths_file)"
  [ -f "$file" ] || return 0
  while IFS= read -r content || [ -n "$content" ]; do
    content="$(trim_whitespace "${content%%#*}")"
    [ -n "$content" ] && printf '%s\n' "$content"
  done < "$file"
}

add_project_allowed_path() {
  local entry="$1" file base line content replaced tmp
  file="$(project_paths_file)"
  [ -f "$file" ] || : > "$file"
  base="$(allowed_path_entry_path "$entry")"
  tmp="${file}.tmp.$$"
  replaced=0
  : > "$tmp"
  while IFS= read -r line || [ -n "$line" ]; do
    content="$(trim_whitespace "${line%%#*}")"
    if [ -n "$content" ] && [ "$(allowed_path_entry_path "$content")" = "$base" ]; then
      printf '%s\n' "$entry" >> "$tmp"
      replaced=1
    else
      printf '%s\n' "$line" >> "$tmp"
    fi
  done < "$file"
  [ "$replaced" -eq 1 ] || printf '%s\n' "$entry" >> "$tmp"
  mv "$tmp" "$file"
}

remove_project_allowed_path() {
  local target="$1" file line content tmp
  file="$(project_paths_file)"
  [ -f "$file" ] || return 0
  tmp="${file}.tmp.$$"
  : > "$tmp"
  while IFS= read -r line || [ -n "$line" ]; do
    content="$(trim_whitespace "${line%%#*}")"
    [ -n "$content" ] && [ "$(allowed_path_entry_path "$content")" = "$target" ] && continue
    printf '%s\n' "$line" >> "$tmp"
  done < "$file"
  mv "$tmp" "$file"
}

# ---- shared package-manager caches ----------------------------------------
# Every agent gets its own HOME ($STATE_ROOT/<agent>), which means every agent
# re-downloads and re-stores the same npm/yarn/cargo/rust artifacts. Those
# directories dominate AgentPod's disk footprint (tens of GB across a handful of
# agents) and are 100% regenerable. We bind-mount one shared copy over the same
# relative path inside each pod's HOME, so all pods hit a single store.
#
# Only regenerable, content-addressable caches and toolchain stores belong here.
# Auth, history, and agent config (.claude, .codex, .config, .ovld, ...) stay
# per-agent on purpose: they are the whole point of the per-agent HOME.
#
# .npm-global is deliberately NOT shared. It is $NPM_CONFIG_PREFIX, an install
# prefix holding live binaries, not a cache: it is where an agent CLI's own
# updater writes when it updates itself. Sharing it lets concurrent pods race
# to npm-install the same package into one directory and swap the binary out
# from under running sessions. Agent CLI versions come from the image instead
# (`agent-pod update-image`), which is why we also pin DISABLE_AUTOUPDATER.
#
# These are shared BETWEEN PODS, not with the host: the host is frequently
# macOS/arm64 while the pod is linux, so a host .cargo/.rustup/.cache holds
# binaries the container cannot execute. Host reuse is opt-in per path via
# AGENT_POD_HOST_CACHES for the platform-neutral ones.
SHARED_CACHE_DIRNAME=".shared-cache"

default_shared_caches() {
  # HOME-relative paths, comma-separated.
  printf '%s\n' ".npm,.cache,.yarn,.cargo,.rustup,.bun,.deno,.local/share/pnpm"
}

shared_cache_root() {
  printf '%s\n' "$STATE_ROOT/$SHARED_CACHE_DIRNAME"
}

# ---- shared codex login ---------------------------------------------------
# Codex authenticates with a device code and stores the resulting ChatGPT
# tokens in ~/.codex/auth.json, inside the per-agent HOME. A login done in the
# `codex` pod is therefore invisible to codex running under any other agent
# name. Unlike Claude Code there is no env-var equivalent to hand the pod, and
# codex rewrites auth.json by atomic rename — which a single-file bind mount
# cannot survive — so the whole ~/.codex directory is shared instead. One
# device-code login, and one set of trusted-project and hook decisions, for
# every pod. Auth is shared here on purpose; this is the deliberate exception
# to the per-agent HOME rule, not a cache.
SHARED_AUTH_DIRNAME=".shared-auth"

shared_auth_root() {
  printf '%s\n' "$STATE_ROOT/$SHARED_AUTH_DIRNAME"
}

# ---- Claude Code first-run onboarding -------------------------------------
# Claude Code gates its onboarding — theme picker, then a browser OAuth login —
# on `hasCompletedOnboarding` in $HOME/.claude.json, not on whether it already
# has usable credentials. A forwarded CLAUDE_CODE_OAUTH_TOKEN authenticates API
# calls but never writes that flag, so an interactive pod that is fully
# authenticated still opens by asking the user to log in, and asks again under
# every agent name, since each one gets its own HOME. Seed the flag so the
# token is actually used.
#
# Only when a credential is present: with nothing to fall back on, skipping
# onboarding would move the login prompt somewhere less obvious rather than
# remove it.
claude_credential_available() {
  local v
  for v in CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN; do
    [ -n "$(config_value "$v" "")" ] && return 0
  done
  return 1
}

# Merge `"hasCompletedOnboarding": true` into an existing .claude.json, via a
# temp file and rename so a pod writing the same file concurrently sees either
# the old or the new content, never a half-written one. Needs a JSON parser:
# the file is Claude Code's, and hand-editing it with sed would eventually
# corrupt someone's config.
merge_claude_onboarding_flag() {
  local file="$1" tmp="$1.agent-pod.tmp"
  if command -v node >/dev/null 2>&1; then
    node -e '
      const fs = require("fs");
      const [file, tmp] = process.argv.slice(1);
      const data = JSON.parse(fs.readFileSync(file, "utf8"));
      data.hasCompletedOnboarding = true;
      fs.writeFileSync(tmp, JSON.stringify(data, null, 2) + "\n", { mode: 0o600 });
      fs.renameSync(tmp, file);
    ' "$file" "$tmp" 2>/dev/null && return 0
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c '
import json, os, sys
file, tmp = sys.argv[1], sys.argv[2]
with open(file) as fh:
    data = json.load(fh)
data["hasCompletedOnboarding"] = True
with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as fh:
    json.dump(data, fh, indent=2)
    fh.write("\n")
os.rename(tmp, file)
' "$file" "$tmp" 2>/dev/null && return 0
  fi
  rm -f "$tmp" 2>/dev/null || true
  return 1
}

seed_claude_onboarding() {
  local file="$STATE_DIR/.claude.json"
  truthy "$(config_value AGENT_POD_CLAUDE_SKIP_ONBOARDING 1)" || return 0
  claude_credential_available || return 0
  if [ ! -e "$file" ]; then
    printf '{\n  "hasCompletedOnboarding": true\n}\n' > "$file" || return 0
    chmod 600 "$file" 2>/dev/null || true
    return 0
  fi
  grep -Eq '"hasCompletedOnboarding"[[:space:]]*:[[:space:]]*true' "$file" 2>/dev/null && return 0
  merge_claude_onboarding_flag "$file" \
    || warn "Could not pre-complete Claude Code onboarding in $file (needs node or python3); claude may prompt to log in despite CLAUDE_CODE_OAUTH_TOKEN."
}

# A cache entry is a HOME-relative path: no leading slash, no "..", no commas.
# Anything else could escape the state root or collide with the HOME mount.
valid_cache_rel_path() {
  case "$1" in
    ""|/*|*,*) return 1;;
    ..|../*|*/..|*/../*) return 1;;
    .|./*) return 1;;
    *) return 0;;
  esac
}

# Resolved list of HOME-relative cache paths to share, one per line.
# Empty when sharing is disabled. Invalid entries are skipped here rather than
# fatal, because this runs inside a command substitution where `die` could only
# kill the subshell — validate_cache_config() is what actually rejects them.
shared_cache_list() {
  local csv entry
  truthy "$(config_value AGENT_POD_SHARE_CACHES 1)" || return 0
  csv="$(config_value AGENT_POD_SHARED_CACHES "$(default_shared_caches)")"
  OLDIFS="$IFS"; IFS=','
  for entry in $csv; do
    IFS="$OLDIFS"
    entry="$(trim_whitespace "$entry")"
    if [ -n "$entry" ] && valid_cache_rel_path "$entry"; then
      printf '%s\n' "$entry"
    fi
    OLDIFS="$IFS"; IFS=','
  done
  IFS="$OLDIFS"
}

# Opt-in host cache reuse. Only safe for platform-neutral stores (npm's
# _cacache and yarn's berry cache hold plain tarballs/zips); anything holding
# compiled binaries will be the wrong architecture inside the pod.
host_cache_list() {
  local csv entry
  csv="$(config_value AGENT_POD_HOST_CACHES "")"
  OLDIFS="$IFS"; IFS=','
  for entry in $csv; do
    IFS="$OLDIFS"
    entry="$(trim_whitespace "$entry")"
    if [ -n "$entry" ] && valid_cache_rel_path "$(allowed_path_entry_path "$entry")"; then
      printf '%s\n' "$entry"
    fi
    OLDIFS="$IFS"; IFS=','
  done
  IFS="$OLDIFS"
}

# Must be called from the current shell (never inside `$(...)`) so a bad config
# value aborts instead of silently dropping a cache path from the mount list.
validate_cache_config() {
  local csv entry
  csv="$(config_value AGENT_POD_SHARED_CACHES "$(default_shared_caches)")"
  OLDIFS="$IFS"; IFS=','
  for entry in $csv; do
    IFS="$OLDIFS"
    entry="$(trim_whitespace "$entry")"
    if [ -n "$entry" ] && ! valid_cache_rel_path "$entry"; then
      die "Invalid AGENT_POD_SHARED_CACHES entry '$entry'. Use HOME-relative paths like '.npm' or '.local/share/pnpm'."
    fi
    OLDIFS="$IFS"; IFS=','
  done
  IFS="$OLDIFS"

  csv="$(config_value AGENT_POD_HOST_CACHES "")"
  OLDIFS="$IFS"; IFS=','
  for entry in $csv; do
    IFS="$OLDIFS"
    entry="$(trim_whitespace "$entry")"
    if [ -n "$entry" ] && ! valid_cache_rel_path "$(allowed_path_entry_path "$entry")"; then
      die "Invalid AGENT_POD_HOST_CACHES entry '$entry'. Use HOME-relative paths like '.npm' or '.yarn:ro'."
    fi
    OLDIFS="$IFS"; IFS=','
  done
  IFS="$OLDIFS"
}

dir_is_empty() {
  [ -d "$1" ] || return 0
  [ -z "$(ls -A "$1" 2>/dev/null)" ]
}

# Size of a directory in KB (0 when missing/unreadable), portable across macOS
# and Linux. Never fails: a du error must not abort a launch under `set -e`.
dir_size_kb() {
  local kb
  [ -d "$1" ] || { printf '0\n'; return 0; }
  kb="$(du -sk "$1" 2>/dev/null | awk '{print $1; exit}' || true)"
  case "$kb" in
    ""|*[!0-9]*) kb=0;;
  esac
  printf '%s\n' "$kb"
}

human_kb() {
  awk -v kb="${1:-0}" 'BEGIN {
    split("KB MB GB TB", u, " ");
    i = 1;
    while (kb >= 1024 && i < 4) { kb /= 1024; i++ }
    printf (kb >= 10 || i == 1) ? "%.0f%s\n" : "%.1f%s\n", kb, u[i];
  }'
}

# Directories under STATE_ROOT that are agent HOMEs. Agent ids must start with a
# lowercase letter, so the dot-prefixed shared cache root can never be one.
agent_state_dirs() {
  local dir name
  [ -d "$STATE_ROOT" ] || return 0
  for dir in "$STATE_ROOT"/*; do
    [ -d "$dir" ] || continue
    name="$(basename "$dir")"
    valid_agent_id "$name" || continue
    printf '%s\n' "$dir"
  done
}

# Move an agent's existing directory into a shared root the first time we see
# it, so the first launch after upgrading keeps what is already on disk — a warm
# cache, or a login the user has already completed — instead of starting empty.
# Only ever moves into an absent/empty shared target, and only with a rename:
# never a multi-gigabyte copy, and never over something already populated.
adopt_into_shared_store() {
  local own="$1" shared="$2"
  [ -d "$own" ] || return 1
  dir_is_empty "$own" && return 1
  [ -e "$shared" ] && ! dir_is_empty "$shared" && return 1
  mkdir -p "$(dirname "$shared")" 2>/dev/null || return 1
  # rmdir only succeeds on an empty dir, so this cannot destroy a populated one.
  [ -d "$shared" ] && { rmdir "$shared" 2>/dev/null || return 1; }
  mv "$own" "$shared" 2>/dev/null || return 1
  return 0
}

run_cache() {
  local action="${1:-status}"
  [ $# -gt 0 ] && shift || true
  local assume_yes=0 arg
  for arg in "$@"; do
    case "$arg" in
      -y|--yes) assume_yes=1;;
      *) die "Usage: agent-pod cache [status|migrate|clean|clear|on|off] [--yes]";;
    esac
  done

  local shared_root rel shared own total_shared total_dup kb
  validate_cache_config
  shared_root="$(shared_cache_root)"

  case "$action" in
    status|"")
      if truthy "$(config_value AGENT_POD_SHARE_CACHES 1)"; then
        ok "Shared caches are enabled."
      else
        warn "Shared caches are DISABLED (AGENT_POD_SHARE_CACHES=0); every agent keeps its own copy."
      fi
      info "Shared cache root: $shared_root"
      total_shared=0
      total_dup=0
      local total_unshared=0 seeded note
      while IFS= read -r rel; do
        [ -n "$rel" ] || continue
        shared="$shared_root/$rel"
        kb="$(dir_size_kb "$shared")"
        total_shared=$((total_shared + kb))
        # A per-agent copy is only reclaimable once a populated shared copy
        # exists to take its place; before that it is the cache, not a duplicate.
        if [ "$kb" -gt 0 ]; then seeded=1; note="shadowed duplicate"; else seeded=0; note="not shared yet"; fi
        printf '  %-22s shared %8s\n' "$rel" "$(human_kb "$kb")" >&2
        while IFS= read -r own; do
          [ -n "$own" ] || continue
          [ -d "$own/$rel" ] || continue
          dir_is_empty "$own/$rel" && continue
          kb="$(dir_size_kb "$own/$rel")"
          if [ "$seeded" -eq 1 ]; then
            total_dup=$((total_dup + kb))
          else
            total_unshared=$((total_unshared + kb))
          fi
          printf '      %-18s %8s  (%s)\n' "$(basename "$own")" "$(human_kb "$kb")" "$note" >&2
        done <<< "$(agent_state_dirs)"
      done <<< "$(shared_cache_list)"
      info "Shared total:      $(human_kb "$total_shared")"
      if [ "$total_unshared" -gt 0 ]; then
        warn "Not yet shared:    $(human_kb "$total_unshared") still held in per-agent copies."
        info "Consolidate with:  agent-pod cache migrate"
      fi
      if [ "$total_dup" -gt 0 ]; then
        warn "Reclaimable:       $(human_kb "$total_dup") in per-agent copies the shared mount now hides."
        info "Reclaim it with:   agent-pod cache clean"
      fi
      ;;

    migrate|adopt)
      # Seed each shared cache from the largest existing per-agent copy (a
      # rename, so it is instant and lossless), then the rest are redundant.
      while IFS= read -r rel; do
        [ -n "$rel" ] || continue
        shared="$shared_root/$rel"
        if [ -d "$shared" ] && ! dir_is_empty "$shared"; then
          info "$rel: shared copy already present."
          continue
        fi
        local best="" best_kb=0
        while IFS= read -r own; do
          [ -n "$own" ] || continue
          [ -d "$own/$rel" ] || continue
          kb="$(dir_size_kb "$own/$rel")"
          if [ "$kb" -gt "$best_kb" ]; then best_kb="$kb"; best="$own/$rel"; fi
        done <<< "$(agent_state_dirs)"
        if [ -n "$best" ] && adopt_into_shared_store "$best" "$shared"; then
          mkdir -p "$best" 2>/dev/null || true
          ok "$rel: adopted $(human_kb "$best_kb") from $(basename "$(dirname "$best")")."
        else
          info "$rel: nothing to adopt."
        fi
      done <<< "$(shared_cache_list)"
      info "Run 'agent-pod cache clean' to delete the now-redundant per-agent copies."
      ;;

    clean)
      total_dup=0
      local -a victims=()
      while IFS= read -r rel; do
        [ -n "$rel" ] || continue
        shared="$shared_root/$rel"
        # Only delete a per-agent copy once a populated shared copy exists to
        # replace it; otherwise cleaning would throw the cache away outright.
        { [ -d "$shared" ] && ! dir_is_empty "$shared"; } || continue
        while IFS= read -r own; do
          [ -n "$own" ] || continue
          [ -d "$own/$rel" ] || continue
          dir_is_empty "$own/$rel" && continue
          kb="$(dir_size_kb "$own/$rel")"
          total_dup=$((total_dup + kb))
          victims+=("$own/$rel")
          printf '  %-40s %8s\n' "${own#$STATE_ROOT/}/$rel" "$(human_kb "$kb")" >&2
        done <<< "$(agent_state_dirs)"
      done <<< "$(shared_cache_list)"
      if [ "${#victims[@]}" -eq 0 ]; then
        ok "Nothing to clean — no per-agent copies are shadowed by a shared cache."
        return 0
      fi
      info "This deletes $(human_kb "$total_dup") of per-agent cache copies already replaced by the shared cache."
      if [ "$assume_yes" -ne 1 ]; then
        prompt_yes_no "Delete these ${#victims[@]} directories?" "no" || { info "Aborted."; return 0; }
      fi
      for own in "${victims[@]}"; do
        rm -rf "$own" && mkdir -p "$own" 2>/dev/null || true
      done
      ok "Reclaimed $(human_kb "$total_dup")."
      ;;

    clear)
      [ -d "$shared_root" ] || { ok "Shared cache root is already empty."; return 0; }
      kb="$(dir_size_kb "$shared_root")"
      info "This deletes the entire shared cache ($(human_kb "$kb")); pods will re-download on next use."
      if [ "$assume_yes" -ne 1 ]; then
        prompt_yes_no "Delete $shared_root?" "no" || { info "Aborted."; return 0; }
      fi
      rm -rf "$shared_root"
      ok "Cleared $(human_kb "$kb")."
      ;;

    on|enable)
      env_file="$(ensure_config_file)"
      upsert_env_var "$env_file" AGENT_POD_SHARE_CACHES 1
      ok "Shared caches enabled for future AgentPod launches."
      ;;

    off|disable)
      env_file="$(ensure_config_file)"
      upsert_env_var "$env_file" AGENT_POD_SHARE_CACHES 0
      ok "Shared caches disabled; each agent will use its own HOME copy again."
      ;;

    *) die "Usage: agent-pod cache [status|migrate|clean|clear|on|off] [--yes]";;
  esac
}

run_file_access() {
  [ $# -ge 1 ] || set -- list
  current="$(config_value AGENT_POD_ALLOWED_PATHS "")"
  case "$1" in
    list|status)
      info "Extra host paths mounted into NEW pods:"
      if [ -n "$current" ]; then
        OLDIFS="$IFS"; IFS=','
        for path in $current; do
          IFS="$OLDIFS"
          printf '  %s (%s)\n' "$(allowed_path_entry_path "$path")" "$(allowed_path_entry_mode "$path")"
          OLDIFS="$IFS"; IFS=','
        done
        IFS="$OLDIFS"
      else
        printf '  (none)\n'
      fi
      info "Config: ${ENV_FILE:-$CONFIG_ENV_FILE}"
      project_entries="$(read_project_paths_file)"
      info "Project file ($(project_paths_file)) in $PWD:"
      if [ -n "$project_entries" ]; then
        while IFS= read -r entry; do
          printf '  %s (%s)\n' "$(allowed_path_entry_path "$entry")" "$(allowed_path_entry_mode "$entry")"
        done <<< "$project_entries"
      else
        printf '  (none)\n'
      fi
      ;;
    add|allow)
      shift
      [ $# -ge 1 ] || die "Usage: agent-pod file-access add [--project] <path>[:ro] [path[:ro]...]"
      project=0
      if [ "$1" = "--project" ]; then
        project=1
        shift
      fi
      [ $# -ge 1 ] || die "Usage: agent-pod file-access add [--project] <path>[:ro] [path[:ro]...]"
      if [ "$project" -eq 1 ]; then
        for entry in "$@"; do
          valid_allowed_path "$entry" \
            || die "Invalid allowed path '$entry'. Use an existing absolute path without commas, optionally suffixed with :ro."
          add_project_allowed_path "$entry"
        done
        ok "Allowed paths in $(project_paths_file) (shared via git):"
      else
        next="$current"
        for entry in "$@"; do
          valid_allowed_path "$entry" \
            || die "Invalid allowed path '$entry'. Use an existing absolute path without commas, optionally suffixed with :ro."
          base="$(allowed_path_entry_path "$entry")"
          if path_in_csv_list "$base" "$next"; then
            filtered=""
            OLDIFS="$IFS"; IFS=','
            for existing in $next; do
              IFS="$OLDIFS"
              [ "$(allowed_path_entry_path "$existing")" = "$base" ] || filtered="${filtered:+$filtered,}$existing"
              OLDIFS="$IFS"; IFS=','
            done
            IFS="$OLDIFS"
            next="$filtered"
          fi
          next="${next:+$next,}$entry"
        done
        env_file="$(ensure_config_file)"
        upsert_env_var "$env_file" AGENT_POD_ALLOWED_PATHS "$next"
        ok "Allowed paths for future pods:"
      fi
      # ${next-...} (not :-) so an emptied personal list still shows (none);
      # the --project branch leaves $next unset, so it falls back to $current.
      AGENT_POD_ALLOWED_PATHS="${next-$current}" run_file_access list
      ;;
    remove|deny)
      shift
      [ $# -ge 1 ] || die "Usage: agent-pod file-access remove [--project] <path> [path...]"
      project=0
      if [ "$1" = "--project" ]; then
        project=1
        shift
      fi
      [ $# -ge 1 ] || die "Usage: agent-pod file-access remove [--project] <path> [path...]"
      if [ "$project" -eq 1 ]; then
        for path in "$@"; do
          remove_project_allowed_path "$(allowed_path_entry_path "$path")"
        done
        ok "Allowed paths in $(project_paths_file) (shared via git):"
      else
        next=""
        OLDIFS="$IFS"; IFS=','
        for existing in $current; do
          IFS="$OLDIFS"
          remove=0
          for path in "$@"; do
            [ "$(allowed_path_entry_path "$existing")" = "$(allowed_path_entry_path "$path")" ] && { remove=1; break; }
          done
          [ "$remove" -eq 1 ] || next="${next:+$next,}$existing"
          OLDIFS="$IFS"; IFS=','
        done
        IFS="$OLDIFS"
        env_file="$(ensure_config_file)"
        upsert_env_var "$env_file" AGENT_POD_ALLOWED_PATHS "$next"
        ok "Allowed paths for future pods:"
      fi
      # ${next-...} (not :-) so an emptied personal list still shows (none);
      # the --project branch leaves $next unset, so it falls back to $current.
      AGENT_POD_ALLOWED_PATHS="${next-$current}" run_file_access list
      ;;
    clear|off|disable)
      [ $# -eq 1 ] || die "Usage: agent-pod file-access clear"
      env_file="$(ensure_config_file)"
      upsert_env_var "$env_file" AGENT_POD_ALLOWED_PATHS ""
      ok "Extra file access disabled for future pods."
      warn "Project file $(project_paths_file) (if present) is untouched; edit it directly or use --project to manage it."
      ;;
    *) die "Usage: agent-pod file-access [list|add [--project] <path[:ro]>...|remove [--project] <path>...|clear]";;
  esac
}

run_docker_access() {
  [ $# -le 1 ] || die "Usage: agent-pod docker-access [on|off|status]"
  current="$(config_value AGENT_POD_DOCKER_ACCESS 0)"
  case "${1:-status}" in
    on|enable|enabled|1|true|yes)
      env_file="$(ensure_config_file)"
      upsert_env_var "$env_file" AGENT_POD_DOCKER_ACCESS 1
      ok "Docker access enabled for future AgentPod launches."
      warn "This mounts the host Docker socket and gives agents control of the host Docker daemon."
      ;;
    off|disable|disabled|0|false|no)
      env_file="$(ensure_config_file)"
      upsert_env_var "$env_file" AGENT_POD_DOCKER_ACCESS 0
      ok "Docker access disabled for future AgentPod launches."
      ;;
    status)
      if truthy "$current"; then
        ok "Docker access is enabled."
      else
        info "Docker access is disabled."
      fi
      info "Config: ${ENV_FILE:-$CONFIG_ENV_FILE}"
      ;;
    *) die "Usage: agent-pod docker-access [on|off|status]";;
  esac
}

run_setup() {
  # Store config with the CLI (~/.agent-pod/.agent-pod.env) by default rather
  # than dropping a file into the current working directory.
  env_file="${AGENT_POD_ENV_FILE:-$CONFIG_ENV_FILE}"
  mkdir -p "$(dirname "$env_file")" 2>/dev/null || true
  if [ ! -f "$env_file" ]; then
    if [ -f "$LAUNCHER_DIR/.agent-pod.env.example" ]; then
      cp "$LAUNCHER_DIR/.agent-pod.env.example" "$env_file"
    else
      : > "$env_file"
    fi
    chmod 600 "$env_file" 2>/dev/null || true
    ok "Created $env_file"
  else
    ok "Updating $env_file"
  fi

  if ! grep -q "AgentPod autonomous flag choices" "$env_file" 2>/dev/null; then
    cat >> "$env_file" <<'EOF'

# AgentPod autonomous flag choices.
# Set a value to 0 to run that agent without AgentPod's default autonomous flag.
EOF
  fi

  chosen_agents="$(prompt_agent_selection)"
  chosen_agents="$(prompt_custom_agents "$env_file" "$chosen_agents")"
  upsert_env_var "$env_file" AGENT_POD_AGENTS "$(agents_csv "$chosen_agents")"

  if agent_in_list claude $chosen_agents; then
    if prompt_yes_no "Use Claude Code autonomous flag (--dangerously-skip-permissions)?" "yes"; then
      upsert_env_var "$env_file" AGENT_POD_CLAUDE_AUTO_FLAGS 1
    else
      upsert_env_var "$env_file" AGENT_POD_CLAUDE_AUTO_FLAGS 0
    fi
  fi

  if agent_in_list codex $chosen_agents; then
    if prompt_yes_no "Use OpenAI Codex autonomous flag (--dangerously-bypass-approvals-and-sandbox)?" "yes"; then
      upsert_env_var "$env_file" AGENT_POD_CODEX_AUTO_FLAGS 1
    else
      upsert_env_var "$env_file" AGENT_POD_CODEX_AUTO_FLAGS 0
    fi
  fi

  upsert_env_var "$env_file" AGENT_POD_OPENCODE_AUTO_FLAGS 0

  if agent_in_list cursor $chosen_agents || agent_in_list agent $chosen_agents; then
    if prompt_yes_no "Use Cursor Agent autonomous flag (--force)?" "yes"; then
      upsert_env_var "$env_file" AGENT_POD_CURSOR_AUTO_FLAGS 1
    else
      upsert_env_var "$env_file" AGENT_POD_CURSOR_AUTO_FLAGS 0
    fi
  fi

  for agent in $chosen_agents; do
    is_builtin_agent "$agent" && continue
    flags="$(custom_agent_flags "$agent")"
    if [ -n "$flags" ]; then
      continue
    fi
    if prompt_yes_no "Add default flags for custom agent '$agent'? (you can also set AGENT_POD_$(agent_env_key "$agent")_FLAGS in the env file)" "no"; then
      custom_flags="$(prompt_text "Flags for $agent (e.g. --force):" || true)"
      if [ -n "$custom_flags" ]; then
        key="$(agent_env_key "$agent")"
        upsert_env_var "$env_file" "AGENT_POD_${key}_FLAGS" "$custom_flags"
      fi
    fi
  done

  if prompt_yes_no "Install Overlord manager package (ovld)?" "yes"; then
    upsert_env_var "$env_file" AGENT_POD_OVERLORD 1
    use_overlord=1
  else
    upsert_env_var "$env_file" AGENT_POD_OVERLORD 0
    use_overlord=0
  fi

  if [ "$use_overlord" = "1" ] && prompt_yes_no "Do you use Overlord to manage agents?" "yes"; then
    current_backend_url="$(dotenv_get OVERLORD_BACKEND_URL "$env_file" 2>/dev/null || true)"
    [ -z "$current_backend_url" ] && current_backend_url="$(dotenv_get OVERLORD_URL "$env_file" 2>/dev/null || true)"
    if [ -n "$current_backend_url" ]; then
      backend_prompt="Overlord backend URL [leave blank to keep existing, default http://127.0.0.1:4310]:"
    else
      backend_prompt="Overlord backend URL [default http://127.0.0.1:4310]:"
    fi
    backend_url="$(prompt_text "$backend_prompt" || true)"
    if [ -n "$backend_url" ]; then
      upsert_env_var "$env_file" OVERLORD_BACKEND_URL "$(normalize_overlord_backend_url "$backend_url")"
    elif [ -z "$current_backend_url" ]; then
      upsert_env_var "$env_file" OVERLORD_BACKEND_URL "http://127.0.0.1:4310"
    fi

    current_overlord_token="$(dotenv_get OVERLORD_USER_TOKEN "$env_file" 2>/dev/null || true)"
    [ -z "$current_overlord_token" ] && current_overlord_token="$(dotenv_get OVERLORD_AGENT_TOKEN "$env_file" 2>/dev/null || true)"
    if [ -n "$current_overlord_token" ]; then
      token_prompt="Overlord user token [leave blank to keep existing]:"
    else
      token_prompt="Overlord user token (Settings > Tokens in Desktop) [leave blank to skip]:"
    fi
    overlord_token="$(prompt_text "$token_prompt" || true)"
    if [ -n "$overlord_token" ]; then
      upsert_env_var "$env_file" OVERLORD_USER_TOKEN "$overlord_token"
    elif [ -z "$current_overlord_token" ]; then
      upsert_env_var "$env_file" OVERLORD_USER_TOKEN ""
    fi
  elif [ "$use_overlord" = "1" ]; then
    info "You should: https://www.ovld.ai"
  fi

  if [ ! -t 0 ]; then
    info "Edit when ready: $env_file"
  elif prompt_yes_no "Open $env_file now?" "yes"; then
    if open_in_editor "$env_file"; then
      ok "Opened $env_file"
    else
      warn "Could not open an editor automatically. Edit this file manually: $env_file"
    fi
  else
    info "Edit when ready: $env_file"
  fi

  offer_image_build
}

# Conclude setup by getting the sandbox image ready. Agents can't run until the
# image exists, so we offer to build it now rather than letting the user hit
# "Image not found" the first time they launch an agent.
offer_image_build() {
  printf '\n' >&2
  if ! command -v docker >/dev/null 2>&1; then
    info "Docker isn't installed yet. Once it is, build the image with: agent-pod install-image"
    return 0
  fi
  if ! docker info >/dev/null 2>&1; then
    info "Docker is installed but not running. Start it, then run: agent-pod install-image"
    return 0
  fi
  if docker image inspect "$IMAGE" >/dev/null 2>&1; then
    ok "Image '$IMAGE' is already built. Rebuild anytime with: agent-pod install-image"
    return 0
  fi
  if prompt_yes_no "Build the agent-pod Docker image now so it's ready for agents? (may take several minutes)" "yes"; then
    if [ -x "$LAUNCHER_DIR/install.sh" ]; then
      "$LAUNCHER_DIR/install.sh" || warn "Image build failed. Retry later with: agent-pod install-image"
    else
      warn "Could not find install.sh next to the launcher. Build later with: agent-pod install-image"
    fi
  else
    info "Build later with: agent-pod install-image"
  fi
}

run_stop() {
  command -v docker >/dev/null 2>&1 || die "Docker is not installed or not on PATH."
  docker info >/dev/null 2>&1       || die "Docker daemon is not running. Start Docker and retry."

  BASE_FILTER=(--filter "label=$MANAGED_LABEL")

  if [ $# -eq 0 ]; then
    containers="$(docker ps -q "${BASE_FILTER[@]}")"
    if [ -z "$containers" ]; then
      info "No running agent-pod containers found."
      return 0
    fi
    count="$(printf '%s\n' "$containers" | wc -l | tr -d ' ')"
    info "Stopping $count agent-pod container(s)..."
    # shellcheck disable=SC2086
    docker stop $containers
    ok "Done."
  else
    stopped_any=0
    for agent in "$@"; do
      containers="$(docker ps -q "${BASE_FILTER[@]}" --filter "label=com.agent-pod.agent=$agent")"
      if [ -z "$containers" ]; then
        warn "No running pod for agent '$agent'."
        continue
      fi
      info "Stopping pod for '$agent'..."
      # shellcheck disable=SC2086
      docker stop $containers
      ok "Stopped '$agent'."
      stopped_any=1
    done
    [ "$stopped_any" -eq 1 ] || warn "No pods were stopped."
  fi
}

run_network() {
  [ $# -le 1 ] || die "Usage: agent-pod network [<name>|off|status]"
  current="$(config_value AGENT_POD_DOCKER_NETWORK "")"
  case "${1:-status}" in
    status)
      if [ -n "$current" ]; then
        ok "Pods attach to Docker network: $current"
      else
        info "No Docker network attached (pods reach host-published ports via host.docker.internal)."
      fi
      info "Config: ${ENV_FILE:-$CONFIG_ENV_FILE}"
      ;;
    off|none|disable|disabled|0|false|no)
      env_file="$(ensure_config_file)"
      upsert_env_var "$env_file" AGENT_POD_DOCKER_NETWORK ""
      ok "Pods will no longer attach to a Docker network."
      ;;
    -*) die "Usage: agent-pod network [<name>|off|status]";;
    *)
      name="$1"
      env_file="$(ensure_config_file)"
      upsert_env_var "$env_file" AGENT_POD_DOCKER_NETWORK "$name"
      ok "Pods will attach to Docker network '$name' on future launches."
      info "List networks with: agent-pod shell docker network ls (requires agent-pod docker-access on)"
      ;;
  esac
}

# Locate the skills bundled with the CLI. They ship next to the launcher.
skills_dir() {
  printf '%s\n' "$LAUNCHER_DIR/skills"
}

# ---- agent-facing protocol surface ---------------------------------------
# `agent-pod protocol` is the structured, copy-pasteable help a coding agent
# reads to configure AgentPod on the user's behalf. Output goes to stdout so it
# is cleanly capturable. Keep each topic concrete: exact commands, the env-file
# keys they write, and the rebuild/verify step.
protocol_overview() {
  cat <<'EOF'
agent-pod protocol — controls for configuring the AgentPod sandbox

You are reading this because a user asked an agent to set up or extend AgentPod.
AgentPod runs coding-agent CLIs inside a throwaway Docker sandbox scoped to the
current project directory. These commands let you change what that sandbox can
do. Each topic below prints exact commands, the config keys they write, and the
rebuild/verify step.

Topics:
  agent-pod protocol agents     Add a custom agent or harness CLI
  agent-pod protocol packages   Bake apt/npm tools into the sandbox image
  agent-pod protocol files      Allowlist extra host file paths to mount
  agent-pod protocol docker     Reach other containers (e.g. local Supabase)
  agent-pod protocol cache      Shared package caches and reclaiming disk space
  agent-pod protocol skills     Where the packaged agent skills live / install them
  agent-pod protocol help       This overview

How config is applied:
  • These commands write to the central config file ~/.agent-pod/.agent-pod.env.
  • Anything that changes what is installed needs an image rebuild:
      agent-pod install-image   first build, or after agent/package changes
      agent-pod update-image    refresh CLIs/packages without resetting auth
  • Changes only affect NEW pods. A running pod keeps the image it started with.

Where to run:
  • agent-pod runs on the HOST — it drives the host Docker daemon and edits the
    host config file. Run it where `agent-pod` is on PATH, not from inside a pod.

Inspect current state:
  agent-pod agents              Enabled agents (with bin/flags/npm)
  agent-pod packages            Custom apt/npm packages baked into the image
  agent-pod file-access list     Extra host paths mounted into new pods
  agent-pod docker-access status
  agent-pod network status
EOF
}

protocol_agents() {
  cat <<'EOF'
agent-pod protocol agents — add a custom agent or harness

AgentPod ships built-in agents (claude, codex, opencode, cursor/agent). You can
add ANY other CLI — another coding agent, a wrapper, or a harness you built.

Add one (writes config and enables it):
  agent-pod agent-add <id> --bin <cli> [--flags "<flags>"] [--npm <package>]

  <id>      lowercase letters/numbers/-/_ (e.g. gemini, my-harness). Not a built-in name.
  --bin     the binary to run inside the container (required)
  --flags   default flags passed every run (e.g. autonomous/skip-permission flags)
  --npm     npm package to install into the image so <bin> exists

Examples:
  agent-pod agent-add gemini --bin gemini --flags "--yolo" --npm @google/gemini-cli
  agent-pod agent-add pi --bin pi --flags "--yolo" --npm @earendil-works/pi-coding-agent
  agent-pod install-image          # rebuild so the new CLI is present
  agent-pod gemini                 # run it, scoped to the current project

If the binary comes from somewhere other than a single npm package, install it
via packages instead of --npm (see: agent-pod protocol packages), then:
  agent-pod agent-add my-harness --bin my-harness-cli --flags "--force"

Config keys written to ~/.agent-pod/.agent-pod.env:
  AGENT_POD_AGENTS=claude,codex,...,<id>     supported agent list
  AGENT_POD_<ID>_BIN=<cli>                   binary (<ID> = id uppercased, - -> _)
  AGENT_POD_<ID>_FLAGS=<flags>               optional default flags
  AGENT_POD_<ID>_NPM=<package>               optional npm package baked at build

Manage / verify:
  agent-pod agents                 list enabled agents with their details
  agent-pod agent-remove <id>      stop supporting an agent
  agent-pod install-image          rebuild after any change above

Notes:
  • AGENT_POD_YOLO=0 drops ALL default flags (built-in and custom).
  • Each agent gets its own persisted auth/history at ~/.agent-pod/<id>/.
EOF
}

protocol_packages() {
  cat <<'EOF'
agent-pod protocol packages — make sure the sandbox image has what the user needs

Tools and libraries the agent needs at runtime must be baked into the image.
Two package channels:
  --npm   global npm packages (default)        e.g. pnpm, typescript, prettier@3
  --apt   Debian system packages via apt-get   e.g. python3, build-essential, postgresql-client

Add (persisted to config, applied on next rebuild):
  agent-pod package-add --npm <pkg...>
  agent-pod package-add --apt <pkg...>

Examples:
  agent-pod package-add --npm pnpm typescript
  agent-pod package-add --apt python3 python3-pip build-essential
  agent-pod package-add --apt postgresql-client       # psql, for DB work
  agent-pod update-image                              # rebuild to install them

Remove / list:
  agent-pod package-remove --npm typescript
  agent-pod package-remove --apt python3
  agent-pod packages                                   # show what's configured

Config keys written to ~/.agent-pod/.agent-pod.env:
  AGENT_POD_NPM_PACKAGES="pnpm typescript"    space-separated global npm packages
  AGENT_POD_APT_PACKAGES="python3 build-essential"  space-separated Debian packages

Rebuild to apply:
  agent-pod update-image          builds/applies package changes
  agent-pod update-image           refresh installed CLIs/packages, keep auth

Verify a tool is present in a fresh pod:
  agent-pod shell <tool> --version     e.g. agent-pod shell python3 --version
EOF
}

protocol_files() {
  cat <<'EOF'
agent-pod protocol files — allowlist extra host file paths

By default a pod can only see the current project directory plus its persisted
agent HOME. Use file access when the user wants an agent launched in one repo to
read, reference, or modify another specific repo/file without exposing all of
the host or mounting the Docker socket.

Programmatic one-launch usage:
  AGENT_POD_ALLOWED_PATHS=/absolute/path/to/other-repo agent-pod codex
  AGENT_POD_ALLOWED_PATHS=/repo/a,/repo/b agent-pod claude
  AGENT_POD_ALLOWED_PATHS=/repo/a:ro,/repo/b agent-pod claude     # :ro = read-only

Persisted config for future launches (personal, written to ~/.agent-pod/.agent-pod.env):
  agent-pod file-access add /absolute/path/to/other-repo
  agent-pod file-access add /absolute/path/to/assets:ro
  agent-pod file-access list
  agent-pod file-access remove /absolute/path/to/other-repo
  agent-pod file-access clear

Shared per-project config (committed to the repo, unlike .agent-pod.env):
  agent-pod file-access add --project /absolute/path/to/assets:ro
  agent-pod file-access remove --project /absolute/path/to/assets
  This writes/reads .agent-pod-allowed-paths in the current directory — one
  path per line, "#" comments, optional :ro/:rw suffix. Commit this file so
  every teammate's pod gets the same extra paths automatically.

Ephemeral, additive, one-launch-only extra paths (e.g. for automation that
injects a task-specific folder right before launch, like Overlord):
  AGENT_POD_EXTRA_ALLOWED_PATHS=/tmp/task-123-assets:ro agent-pod claude
  This is env-only — never read from or written to a config file. It is
  ADDED on top of whatever the personal config and project file already
  allow; it never replaces or persists them, and it never overrides the mode
  of a path that's already allowed by either of those two sources.

Path entry format (identical for all three sources):
  <absolute-path>[:rw|:ro]  — comma-separated; no suffix means :rw.
  Whitespace around entries is trimmed, so "/repo/a:rw, /repo/b:ro" is fine.
  A service writing AGENT_POD_EXTRA_ALLOWED_PATHS should put an explicit
  :rw/:ro on EVERY entry rather than relying on the default — the permission
  is then self-documenting in both the value and the startup log line
  ("Allowing host path in pod (rw): ...").

Config key written to ~/.agent-pod/.agent-pod.env:
  AGENT_POD_ALLOWED_PATHS=/repo/a,/repo/b:ro     comma-separated existing absolute paths

How it mounts:
  • Each allowed path is bind-mounted at the same absolute path inside the
    pod, read/write by default or read-only with a ":ro" suffix.
  • Paths must already exist, must be absolute, and cannot contain commas.
  • The launch directory (the current project) is ALWAYS mounted read/write;
    listing it in an allowlist is harmless (it's de-duplicated), and a ":ro"
    on it is ignored — the agent must be able to write where it runs.
  • All three sources (env/config allowlist, project file, and
    AGENT_POD_EXTRA_ALLOWED_PATHS) are merged for every launch; first match
    wins in that order, so a path's mode is set by whichever source lists it
    first.
  • Settings apply only to NEW pods; restart the pod after changing them.
  • Keep the list narrow. Every read/write path is editable by the agent
    process; use :ro for paths the agent should only read.

Verify in a fresh pod:
  agent-pod shell test -e /absolute/path/to/other-repo
EOF
}

protocol_docker() {
  cat <<'EOF'
agent-pod protocol docker — let the pod reach other Docker containers

By default a pod only sees the current project directory and cannot control the
host Docker daemon. A common need is reaching OTHER containers — for example a
local Supabase stack — so the agent can apply migrations, query the DB, etc.

There are two independent capabilities. Enable whichever the task needs.

1) Docker daemon control (inspect/manage containers, run docker commands)
   agent-pod docker-access on        # mount the host Docker socket into pods
   agent-pod docker-access status
   agent-pod docker-access off
   Then, inside a pod: docker ps, docker logs, docker exec, docker network ls, ...
   PRIVILEGED: socket access = full control of the host Docker daemon. Enable
   only when needed; turn it off when done.

2) Network reachability (talk to services those containers expose)
   • Host-published ports work out of the box from inside the pod via the host
     gateway. A service on the host at localhost:PORT is reachable at:
         host.docker.internal:PORT
   • To reach containers directly by name on their own Docker network, attach
     the pod to that network:
         agent-pod network <network-name>     # set the network to join
         agent-pod network status
         agent-pod network off                # stop attaching

Example — apply migrations against a local Supabase stack:
  # 1. Start Supabase on the host (publishes the DB on localhost:54322 by default)
  supabase start
  # 2. Make the Supabase/Postgres client available in the pod
  agent-pod package-add --apt postgresql-client
  agent-pod install-image
  # 3a. Reach the published DB port from inside the pod via the host gateway:
  agent-pod shell psql "postgresql://postgres:postgres@host.docker.internal:54322/postgres" -c '\dt'
  #     ...or run your migration tool against that connection string.
  # 3b. Or, to use Supabase's own network and container DNS names, find and join it:
  agent-pod docker-access on
  agent-pod shell docker network ls          # look for supabase_network_<project>
  agent-pod network supabase_network_<project>
  #     then reach the db container directly, e.g. host "supabase_db_<project>".

Config keys written to ~/.agent-pod/.agent-pod.env:
  AGENT_POD_DOCKER_ACCESS=1                 mount the host Docker socket
  AGENT_POD_DOCKER_SOCKET=/var/run/docker.sock   socket path (override if non-standard)
  AGENT_POD_DOCKER_NETWORK=<name>           Docker network pods attach to

Notes:
  • host.docker.internal is always available inside pods (no opt-in needed).
  • Network/socket settings apply to NEW pods; restart the pod after changing them.
EOF
}

protocol_cache() {
  cat <<EOF
agent-pod cache — shared package-manager caches and disk usage

Every agent runs with its own HOME on the host ($STATE_ROOT/<agent>), which keeps
auth, history, and agent config properly isolated. Without help it ALSO gives
every agent its own copy of every package-manager cache, so the same npm tarballs,
yarn zips, crates, and rust toolchains get downloaded and stored once per agent.
That duplication is what makes AgentPod's footprint grow into tens of gigabytes.

AgentPod now bind-mounts ONE shared copy of those caches over the same path in
every pod's HOME. Nothing else is shared: .claude, .codex, .config, .ovld and the
rest of each agent's state stay private to that agent.

Commands:
  agent-pod cache                 Show shared cache sizes and reclaimable space
  agent-pod cache migrate         Seed the shared cache from existing per-agent copies
  agent-pod cache clean           Delete per-agent copies the shared cache replaced
  agent-pod cache clear           Empty the shared cache (pods re-download on demand)
  agent-pod cache off             Go back to a private cache per agent
  agent-pod cache on              Re-enable sharing

Shared by default (HOME-relative):
  $(default_shared_caches | tr ',' ' ')

Config keys written to ~/.agent-pod/.agent-pod.env:
  AGENT_POD_SHARE_CACHES=1        master switch (default on)
  AGENT_POD_SHARED_CACHES=.npm,.cache,...
                                  override the shared list entirely
  AGENT_POD_HOST_CACHES=          opt-in reuse of the HOST's own caches (default: none)

Reusing the host's caches (AGENT_POD_HOST_CACHES):
  Entries are HOME-relative paths with an optional :ro/:rw suffix, e.g.
      AGENT_POD_HOST_CACHES=.npm,.yarn:ro
  which mounts ~/.npm and ~/.yarn from the host into every pod. Use this ONLY for
  stores whose contents are platform-neutral — npm's _cacache and yarn berry's
  cache hold plain tarballs/zips and are safe. Do NOT do it for .cargo, .rustup,
  .cache, .bun, or .npm-global when the host is macOS/Windows and the pod is
  linux: those hold compiled binaries for the host's architecture and the pod
  will fail to execute them. A host entry replaces the shared-cache mount for
  that same path.

Notes:
  • Mounts apply to NEW pods; restart the pod after changing any of this.
  • The first launch after upgrading renames an agent's existing cache into the
    shared store, so a warm cache is kept rather than re-downloaded. Later agents
    see their own copies shadowed — 'agent-pod cache clean' reclaims that space.
  • Caches are regenerable. Deleting any of them only costs a re-download.
EOF
}

protocol_skills() {
  dir="$(skills_dir)"
  case "${1:-}" in
    --install|install)
      target="${2:-.claude/skills}"
      [ -d "$dir" ] || die "Packaged skills not found at: $dir"
      mkdir -p "$target" || die "Could not create $target"
      cp -R "$dir/." "$target/" || die "Could not copy skills into $target"
      ok "Installed AgentPod skills into $target"
      info "Restart your agent (or reload skills) so it picks them up."
      ;;
    ""|list)
      cat <<EOF
agent-pod protocol skills — agent skills packaged with the CLI

AgentPod ships skills that teach coding agents how to configure the sandbox.
They simply point the agent at 'agent-pod protocol' (this command), so the
authoritative instructions stay in one place.

Location (bundled with the CLI):
  $dir

Install them into a project so a Claude Code agent discovers them:
  agent-pod protocol skills --install            # -> ./.claude/skills/
  agent-pod protocol skills --install <dir>      # custom destination

Bundled skills:
EOF
      if [ -d "$dir" ]; then
        for s in "$dir"/*/; do
          [ -d "$s" ] || continue
          printf '  %s\n' "$(basename "$s")"
        done
      else
        printf '  (none found at %s)\n' "$dir"
      fi
      ;;
    *) die "Usage: agent-pod protocol skills [--install [dir]]";;
  esac
}

run_protocol() {
  topic="${1:-help}"
  [ $# -gt 0 ] && shift || true
  case "$topic" in
    help|-h|--help|"") protocol_overview;;
    agents|agent|harness|harnesses) protocol_agents;;
    packages|package|deps|dependencies) protocol_packages;;
    files|file|file-access|paths|mounts|allowlist) protocol_files;;
    docker|docker-access|containers|network|networking|supabase) protocol_docker;;
    cache|caches|storage|disk) protocol_cache;;
    skills|skill) protocol_skills "$@";;
    *) die "Unknown protocol topic '$topic'. Run: agent-pod protocol help";;
  esac
}

usage() {
  cat >&2 <<EOF
agent-pod — sandboxed AI coding agents in Docker

Usage:
  agent-pod <agent> [args...]    Run an agent in the current directory
  agent-pod shell                Open a shell inside the sandbox
  agent-pod setup                Create/edit ~/.agent-pod/.agent-pod.env
  agent-pod agents               Show enabled agents
  agent-pod agent-add <agent...> Add supported agents
  agent-pod agent-remove <agent...>
                                  Remove supported agents
  agent-pod packages             Show custom apt/npm packages baked into the image
  agent-pod package-add [--npm|--apt] <pkg...>
                                  Add custom packages to bake into the image
  agent-pod package-remove [--npm|--apt] <pkg...>
                                  Remove custom packages from the image
  agent-pod file-access [list|add|remove|clear] [--project] <path[:ro]>
                                  Allowlist extra host paths for new pods
  agent-pod cache [status|migrate|clean|clear|on|off]
                                  Inspect and reclaim shared package-manager caches
  agent-pod docker-access [on|off|status]
                                  Show or toggle host Docker socket mounting
  agent-pod network [<name>|off|status]
                                  Attach launched pods to a Docker network
  agent-pod protocol [topic]     Agent-facing help for configuring the sandbox
                                  (topics: agents, packages, files, docker, cache, skills)
  agent-pod edit-env             Open the active env file in your editor
  agent-pod install-image        Build the Docker image used by agent-pod
  agent-pod update-image         Refresh CLIs and packages in the Docker image
  agent-pod start                Alias for update-image (re-pull image after prune)
  agent-pod stop [agent...]      Stop running agent-pod container(s)
  agent-pod prune [hours]        Remove stopped AgentPod containers
  agent-pod update               Update agent-pod-cli to the latest version
  agent-pod version              Print the installed agent-pod-cli version
  agent-pod uninstall            Remove the Docker image and ~/.agent-pod state
  agent-pod --help

Agents (built-in):
  claude     Claude Code      (claude; optional --dangerously-skip-permissions)
  codex      OpenAI Codex     (codex; optional --dangerously-bypass-approvals-and-sandbox)
  opencode   OpenCode         (opencode)
  agent      Cursor Agent     (agent; optional --force)
  cursor     Cursor Agent     (agent alias; optional --force)

Custom agents:
  agent-pod agent-add <name> --bin <cli> [--flags "<flags>"] [--npm <package>]
  agent-pod <name> [args...]   Run any configured custom agent or harness

Anything after the agent name is passed straight through to the CLI, e.g.
  agent-pod claude -p "summarize this repo"
  agent-pod codex exec "run the tests"
  agent-pod package-add --npm pnpm eslint@9
  agent-pod file-access add /absolute/path/to/other-repo
  agent-pod install-image

Configuring the sandbox (custom agents, packages, files, Docker/Supabase access):
  Easiest path — ask your coding agent to do it. Tell it to read
  'agent-pod protocol help' and configure what you need, e.g.
    "Check 'agent-pod protocol help', add the gemini CLI, install psql, and
     give the pod access to my local Supabase so you can apply migrations."
  Or run 'agent-pod protocol help' yourself for the exact commands.

Configuration & environment variables (PORTS, AGENT_POD_ENV_FILE,
AGENT_POD_AGENTS, AGENT_POD_ALLOWED_PATHS, auth keys, pruning, and more):
  agent-pod setup        Guided setup of ~/.agent-pod/.agent-pod.env
  agent-pod edit-env     Open the active env file in your editor
  Full reference: https://github.com/jchaselubitz/agent-pod#readme

Auth: log in interactively once (it persists), or export a provider key
(ANTHROPIC_API_KEY, OPENAI_API_KEY, CURSOR_API_KEY, ...) and it is forwarded
into the container automatically.

Only the current directory is mounted in:
  $PWD

Extra allowed paths can be mounted into new pods with:
  agent-pod file-access add /absolute/path/to/other-repo
EOF
}

# Env-file ergonomics. Docker reads KEY=VALUE lines and comments. Prefer a
# project-local file, then fall back to a central file next to this launcher.
ENV_FILE="$(discover_env_file)"

IMAGE="$(config_value AGENT_POD_IMAGE agent-pod)"
STATE_ROOT="$(config_value AGENT_POD_HOME "$HOME/.agent-pod")"
PORTS_VALUE="$(config_value PORTS "${PORTS:-}")"
AGENT_POD_ENV_VALUE="$(config_value AGENT_POD_ENV "${AGENT_POD_ENV:-}")"
AGENT_POD_ALLOWED_PATHS_VALUE="$(config_value AGENT_POD_ALLOWED_PATHS "${AGENT_POD_ALLOWED_PATHS:-}")"
# Ephemeral, additive, per-launch extra paths. Env-only on purpose (never read
# from a config file) so automation (e.g. Overlord injecting a task-specific
# folder right before launch) can add a path for one run without touching, or
# being overridden by, the persisted personal/project allowlists.
AGENT_POD_EXTRA_ALLOWED_PATHS_VALUE="${AGENT_POD_EXTRA_ALLOWED_PATHS:-}"

# ---- argument parsing -----------------------------------------------------
[ $# -ge 1 ] || { usage; exit 1; }
case "$1" in -h|--help|help) usage; exit 0;; esac
case "$1" in -v|--version) run_version; exit 0;; esac
case "$1" in
  setup) run_setup; exit 0;;
  agents) run_agents_list; exit 0;;
  agent-add|add-agent) shift; run_agent_add "$@"; exit 0;;
  agent-remove|remove-agent) shift; run_agent_remove "$@"; exit 0;;
  packages) shift; run_packages_list "$@"; exit 0;;
  package-add|add-package) shift; run_package_add "$@"; exit 0;;
  package-remove|remove-package) shift; run_package_remove "$@"; exit 0;;
  file-access|files|allowlist) shift; run_file_access "$@"; exit 0;;
  cache|caches|storage|disk) shift; run_cache "$@"; exit 0;;
  docker-access) shift; run_docker_access "$@"; exit 0;;
  network) shift; run_network "$@"; exit 0;;
  protocol) shift; run_protocol "$@"; exit 0;;
  edit-env) run_edit_env; exit 0;;
  update) run_update; exit 0;;
  version) shift; run_version "$@"; exit 0;;
  start|update-image) shift; run_update_image "$@"; exit 0;;
  stop) shift; run_stop "$@"; exit 0;;
  prune) shift; run_prune "$@"; exit 0;;
  install-image)
    exec "$LAUNCHER_DIR/install.sh"
    ;;
  uninstall)
    exec "$LAUNCHER_DIR/uninstall.sh"
    ;;
esac

AGENT="$1"; shift

if [ "$AGENT" = "shell" ]; then
  BIN="bash"
  YOLO=()
else
  valid_agent_id "$AGENT" \
    || die "Unknown agent '$AGENT'. Run: agent-pod agents"
  ENABLED_AGENTS="$(supported_agents)"
  agent_in_list "$AGENT" $ENABLED_AGENTS \
    || die "'$AGENT' is not enabled. Add it with: agent-pod agent-add $AGENT && agent-pod update-image"
  resolve_agent_launch "$AGENT"
fi

# ---- preflight ------------------------------------------------------------
command -v docker >/dev/null 2>&1 || die "Docker is not installed or not on PATH."
docker info >/dev/null 2>&1       || die "Docker daemon is not running. Start Docker and retry."
auto_prune_if_due
docker image inspect "$IMAGE" >/dev/null 2>&1 \
  || die "Image '$IMAGE' not found. Build it first:  ./install.sh"

# ---- per-agent state dir (becomes the container's HOME) --------------------
STATE_DIR="$STATE_ROOT/$AGENT"
mkdir -p "$STATE_DIR"
mkdir -p "$STATE_DIR/.npm-global"
# Owner-only: this holds auth tokens and conversation transcripts.
chmod 700 "$STATE_ROOT" "$STATE_DIR" 2>/dev/null || true
# Runs for every agent, not just `claude`: any pod can invoke the claude CLI,
# and each agent name has its own HOME to onboard.
seed_claude_onboarding

# ---- opt-in host cache reuse ----------------------------------------------
# Off by default: only stores holding platform-neutral artifacts are safe to
# share with a host that may be a different OS/architecture than the pod.
# Processed first so an explicit host entry wins over the shared-cache default
# for the same path — two mounts on one destination is a hard Docker error.
validate_cache_config
HOST_CACHE_FLAGS=()
HOST_CACHE_RELS=""
while IFS= read -r host_entry; do
  [ -n "$host_entry" ] || continue
  host_rel="$(allowed_path_entry_path "$host_entry")"
  host_mode="$(allowed_path_entry_mode "$host_entry")"
  host_src="$HOME/$host_rel"
  [ -d "$host_src" ] || { warn "Skipping AGENT_POD_HOST_CACHES entry (not found on host): ~/$host_rel"; continue; }
  path_in_csv_list "$host_rel" "$HOST_CACHE_RELS" && continue
  HOST_CACHE_RELS="${HOST_CACHE_RELS:+$HOST_CACHE_RELS,}$host_rel"
  mkdir -p "$STATE_DIR/$host_rel" 2>/dev/null || true
  HOST_CACHE_FLAGS+=(-v "$host_src:$CONTAINER_HOME/$host_rel:$host_mode")
  info "Sharing host cache in pod ($host_mode): ~/$host_rel"
done <<< "$(host_cache_list)"

# ---- shared package-manager caches ----------------------------------------
# Nested bind mounts layered on top of the HOME mount below. Docker applies
# mounts shallowest-destination first, so $CONTAINER_HOME lands before
# $CONTAINER_HOME/.npm and each cache path resolves to the shared store instead
# of this agent's private copy.
SHARED_CACHE_FLAGS=()
SHARED_CACHE_ROOT="$(shared_cache_root)"
SHADOWED_CACHE_COUNT=0
while IFS= read -r cache_rel; do
  [ -n "$cache_rel" ] || continue
  path_in_csv_list "$cache_rel" "$HOST_CACHE_RELS" && continue
  shared_dir="$SHARED_CACHE_ROOT/$cache_rel"
  own_dir="$STATE_DIR/$cache_rel"
  # First launch after upgrading: hand this agent's warm cache to the shared
  # store by renaming it, so nothing has to be re-downloaded.
  if adopt_into_shared_store "$own_dir" "$shared_dir"; then
    info "Adopted $cache_rel into the shared cache."
  elif [ -d "$own_dir" ] && ! dir_is_empty "$own_dir"; then
    SHADOWED_CACHE_COUNT=$((SHADOWED_CACHE_COUNT + 1))
  fi
  # Pre-create both ends so Docker never has to materialize a mount point
  # itself (which would create it root-owned inside the bind-mounted HOME).
  mkdir -p "$shared_dir" "$own_dir" 2>/dev/null || true
  SHARED_CACHE_FLAGS+=(-v "$shared_dir:$CONTAINER_HOME/$cache_rel")
done <<< "$(shared_cache_list)"
if [ -d "$SHARED_CACHE_ROOT" ]; then
  chmod 700 "$SHARED_CACHE_ROOT" 2>/dev/null || true
fi
if [ "$SHADOWED_CACHE_COUNT" -gt 0 ]; then
  warn "$SHADOWED_CACHE_COUNT per-agent cache dir(s) are shadowed by the shared cache; reclaim that space with: agent-pod cache clean"
fi

# ---- shared codex login ---------------------------------------------------
# Mounted for every agent, not just `codex`, so one device-code login covers
# codex however it is launched. Same nesting rule as the caches above: the HOME
# mount lands first, then this shadows $CONTAINER_HOME/.codex.
SHARED_AUTH_FLAGS=()
if truthy "$(config_value AGENT_POD_SHARE_CODEX_AUTH 1)"; then
  SHARED_AUTH_ROOT="$(shared_auth_root)"
  SHARED_CODEX_DIR="$SHARED_AUTH_ROOT/.codex"
  # First launch after upgrading: hand the login already sitting in the codex
  # pod's HOME to the shared store, so the user does not have to re-authenticate.
  if adopt_into_shared_store "$STATE_ROOT/codex/.codex" "$SHARED_CODEX_DIR"; then
    info "Adopted the existing codex login into the shared auth store."
  fi
  mkdir -p "$SHARED_CODEX_DIR" "$STATE_DIR/.codex" 2>/dev/null || true
  # Tokens live here, so keep both levels owner-only.
  chmod 700 "$SHARED_AUTH_ROOT" "$SHARED_CODEX_DIR" 2>/dev/null || true
  SHARED_AUTH_FLAGS+=(-v "$SHARED_CODEX_DIR:$CONTAINER_HOME/.codex")
fi

# ---- git identity (written to the container's ~/.gitconfig) ---------------
GIT_USER_EMAIL_VALUE="$(config_value GIT_USER_EMAIL "")"
GIT_USER_NAME_VALUE="$(config_value GIT_USER_NAME "")"
if [ -n "$GIT_USER_EMAIL_VALUE" ] || [ -n "$GIT_USER_NAME_VALUE" ]; then
  if command -v git >/dev/null 2>&1; then
    [ -n "$GIT_USER_EMAIL_VALUE" ] && git config --file "$STATE_DIR/.gitconfig" user.email "$GIT_USER_EMAIL_VALUE"
    [ -n "$GIT_USER_NAME_VALUE"  ] && git config --file "$STATE_DIR/.gitconfig" user.name  "$GIT_USER_NAME_VALUE"
  else
    warn "git not found on host; skipping git identity setup (GIT_USER_EMAIL / GIT_USER_NAME)."
  fi
fi

# ---- TTY handling ---------------------------------------------------------
# Always forward stdin (-i) so piping works; only allocate a pty (-t) when both
# ends are real terminals.
TTY_FLAGS=(-i)
if [ -t 0 ] && [ -t 1 ]; then TTY_FLAGS+=(-t); fi

# ---- port publishing ------------------------------------------------------
PORT_FLAGS=()
if [ -n "$PORTS_VALUE" ]; then
  OLDIFS="$IFS"; IFS=','
  for p in $PORTS_VALUE; do
    p="${p// /}"
    [ -z "$p" ] && continue
    case "$p" in *[!0-9]*) die "Invalid port: '$p'";; esac
    { [ "$p" -ge 1 ] && [ "$p" -le 65535 ]; } || die "Port out of range (1-65535): $p"
    PORT_FLAGS+=(-p "127.0.0.1:$p:$p")
  done
  IFS="$OLDIFS"
fi

# ---- forward known provider / tooling credentials (only if set) ----------
ENV_FLAGS=()
for v in \
  ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL CLAUDE_CODE_OAUTH_TOKEN \
  OPENAI_API_KEY OPENAI_BASE_URL OPENAI_ORGANIZATION \
  CURSOR_API_KEY \
  GEMINI_API_KEY GOOGLE_API_KEY OPENROUTER_API_KEY GROQ_API_KEY \
  XAI_API_KEY DEEPSEEK_API_KEY MISTRAL_API_KEY \
  GITHUB_TOKEN GH_TOKEN \
  OVERLORD_BACKEND_URL OVERLORD_USER_TOKEN OVLD_USER_TOKEN \
  OVERLORD_URL OVERLORD_AGENT_TOKEN; do
  [ -n "${!v:-}" ] && ENV_FLAGS+=(-e "$v")
done

# Map legacy Overlord env names to the current keys when only the old names
# are present in the config file (docker --env-file does not rename keys).
overlord_user_token="$(config_value OVERLORD_USER_TOKEN "")"
[ -z "$overlord_user_token" ] && overlord_user_token="$(config_value OVERLORD_AGENT_TOKEN "")"
[ -n "$overlord_user_token" ] && ENV_FLAGS+=(-e "OVERLORD_USER_TOKEN=$overlord_user_token")

overlord_backend_url="$(config_value OVERLORD_BACKEND_URL "")"
[ -z "$overlord_backend_url" ] && overlord_backend_url="$(config_value OVERLORD_URL "")"
overlord_backend_url="$(normalize_overlord_backend_url "$overlord_backend_url")"
[ -n "$overlord_backend_url" ] && ENV_FLAGS+=(-e "OVERLORD_BACKEND_URL=$overlord_backend_url")

# Forward any extra host variables requested for this project/session.
# Accept commas or spaces so both `FOO,BAR` and `FOO BAR` work.
if [ -n "$AGENT_POD_ENV_VALUE" ]; then
  for v in ${AGENT_POD_ENV_VALUE//,/ }; do
    [ -z "$v" ] && continue
    case "$v" in
      [A-Za-z_]*) ;;
      *) die "Invalid environment variable name in AGENT_POD_ENV: '$v'";;
    esac
    case "$v" in
      *[!A-Za-z0-9_]*) die "Invalid environment variable name in AGENT_POD_ENV: '$v'";;
    esac
    if [ -n "${!v+x}" ]; then
      ENV_FLAGS+=(-e "$v")
    else
      warn "Skipping unset environment variable from AGENT_POD_ENV: $v"
    fi
  done
fi

# ---- pin agent CLI versions to the image ----------------------------------
# The image is the single source of truth for harness versions: `agent-pod
# update-image` rebuilds it with a fresh `npm install -g <cli>@latest`. An
# agent CLI's own updater fights that — it installs into $NPM_CONFIG_PREFIX
# inside the pod, which is per-agent state that the next `update-image` does
# not touch, so the two drift apart. Turn the updater off unless the user
# explicitly wants pods to self-update.
if ! truthy "$(config_value AGENT_POD_AGENT_AUTOUPDATE 0)"; then
  ENV_FLAGS+=(-e "DISABLE_AUTOUPDATER=1")
fi

ENV_FILE_FLAGS=()
if [ -n "$ENV_FILE" ]; then
  [ -f "$ENV_FILE" ] || die "AGENT_POD_ENV_FILE does not exist: $ENV_FILE"
  ENV_FILE_FLAGS+=(--env-file "$ENV_FILE")
fi

# ---- optional allowlisted host file access --------------------------------
# Two sources, merged: the env/config allowlist (personal, can live outside
# the repo) and the project file .agent-pod-allowed-paths (committed, shared
# with the team). The env/config source wins when both list the same path.
FILE_ACCESS_FLAGS=()
# Seed the dedup tracker with the working directory: it is always mounted rw
# via `-v "$PWD:$PWD"` below, so an allowlist entry naming it (common, since the
# launch dir is often in the reachable-paths list) must not add a second mount
# for the same destination — Docker rejects that with "Duplicate mount point".
# The working dir stays rw even if the allowlist asked for :ro; the agent needs
# to write where it runs.
ALLOWED_PATHS_SEEN="$PWD"

add_allowed_path_flag() {
  local entry="$1" source_label="$2" path mode
  valid_allowed_path "$entry" \
    || die "Invalid $source_label entry '$entry'. Use an existing absolute path without commas, optionally suffixed with :ro."
  path="$(allowed_path_entry_path "$entry")"
  path_in_csv_list "$path" "$ALLOWED_PATHS_SEEN" && return 0
  ALLOWED_PATHS_SEEN="${ALLOWED_PATHS_SEEN:+$ALLOWED_PATHS_SEEN,}$path"
  mode="$(allowed_path_entry_mode "$entry")"
  FILE_ACCESS_FLAGS+=(-v "$path:$path:$mode")
  info "Allowing host path in pod ($mode): $path"
}

# Add every entry in a comma-separated allowlist to the mount flags.
add_allowed_paths_from_csv() {
  local csv="$1" label="$2" entry
  [ -n "$csv" ] || return 0
  OLDIFS="$IFS"; IFS=','
  for entry in $csv; do
    IFS="$OLDIFS"
    # Trim per-entry whitespace so a value written by hand or by an external
    # service can space out entries ("/a:rw, /b:ro") the same way the project
    # allowlist file already tolerates. Without this a leading space fails the
    # absolute-path check.
    entry="$(trim_whitespace "$entry")"
    [ -n "$entry" ] && add_allowed_path_flag "$entry" "$label"
    OLDIFS="$IFS"; IFS=','
  done
  IFS="$OLDIFS"
}

# Order matters: first source to list a path sets its mount mode. Personal
# env/config wins over the committed project file, which wins over the
# ephemeral per-launch extras.
add_allowed_paths_from_csv "$AGENT_POD_ALLOWED_PATHS_VALUE" "AGENT_POD_ALLOWED_PATHS"

PROJECT_PATHS_ENTRIES="$(read_project_paths_file)"
if [ -n "$PROJECT_PATHS_ENTRIES" ]; then
  while IFS= read -r project_path_entry; do
    add_allowed_path_flag "$project_path_entry" "$(project_paths_file)"
  done <<< "$PROJECT_PATHS_ENTRIES"
fi

add_allowed_paths_from_csv "$AGENT_POD_EXTRA_ALLOWED_PATHS_VALUE" "AGENT_POD_EXTRA_ALLOWED_PATHS"

# ---- optional host Docker daemon access ----------------------------------
DOCKER_ACCESS_FLAGS=()
if truthy "$(config_value AGENT_POD_DOCKER_ACCESS 0)"; then
  DOCKER_SOCKET="${AGENT_POD_DOCKER_SOCKET:-/var/run/docker.sock}"
  [ -S "$DOCKER_SOCKET" ] || die "AGENT_POD_DOCKER_ACCESS is enabled, but Docker socket was not found: $DOCKER_SOCKET"
  DOCKER_ACCESS_FLAGS+=(-v "$DOCKER_SOCKET:/var/run/docker.sock")
  if socket_gid="$(stat -f '%g' "$DOCKER_SOCKET" 2>/dev/null || stat -c '%g' "$DOCKER_SOCKET" 2>/dev/null)"; then
    case "$socket_gid" in
      ""|*[!0-9]*) ;;
      *) DOCKER_ACCESS_FLAGS+=(--group-add "$socket_gid");;
    esac
  fi
  warn "Docker access enabled: agents can control the host Docker daemon."
fi

# ---- container networking -------------------------------------------------
# Always give pods a name for the host so they can reach host-published ports
# (e.g. a local Supabase stack on 127.0.0.1:54322) via host.docker.internal,
# including on Linux where that name isn't resolved automatically. Optionally
# attach the pod to a Docker network so it can reach other containers by name.
NETWORK_FLAGS=(--add-host "host.docker.internal:host-gateway")
DOCKER_NETWORK_VALUE="$(config_value AGENT_POD_DOCKER_NETWORK "")"
if [ -n "$DOCKER_NETWORK_VALUE" ]; then
  NETWORK_FLAGS+=(--network "$DOCKER_NETWORK_VALUE")
  info "Attaching pod to Docker network: $DOCKER_NETWORK_VALUE"
fi

# ---- assemble the command -------------------------------------------------
CMD=("$BIN")
[ ${#YOLO[@]} -gt 0 ] && CMD+=("${YOLO[@]}")
[ $# -gt 0 ] && CMD+=("$@")

# Configure Overlord inside the pod and register agent plugins before launch.
# `ovld launch` runs on the HOST and cannot write into the pod's HOME, so config
# and plugin install must happen here, in-container, as the agent's own user/HOME.
# When OVERLORD_BACKEND_URL is set, write ~/.ovld/overlord.toml from the forwarded
# env vars. `ovld agent-setup <agent>` installs via the agent's plugin CLI and is
# idempotent, so it is safe to run on every start. Output is sent to stderr to
# keep the agent's stdout clean for non-interactive (`-p`/`exec`) captures.
# Only built-in agents with an Overlord plugin have a setup target.
OVLD_SETUP_TARGET=""
case "$AGENT" in
  claude) OVLD_SETUP_TARGET=claude;;
  codex)  OVLD_SETUP_TARGET=codex;;
esac
BOOTSTRAP=""
if [ -n "$overlord_backend_url" ]; then
  BOOTSTRAP="$(overlord_in_pod_bootstrap_fragment)"
fi
if [ -n "$OVLD_SETUP_TARGET" ]; then
  BOOTSTRAP="${BOOTSTRAP}if command -v ovld >/dev/null 2>&1; then ovld agent-setup $OVLD_SETUP_TARGET </dev/null >&2 || true; fi; "
fi

# Claude Code's Bun-built Linux arm64 binary can bus-error when Docker starts
# it directly as the container command. Launching through bash preserves argv
# while matching the stable `agent-pod shell -lc 'claude ...'` path. Wrapping in
# bash also gives us a place to run the Overlord bootstrap before exec'ing the
# agent, so any agent with a bootstrap step takes the same path.
if [ "$AGENT" = "claude" ] || [ -n "$BOOTSTRAP" ]; then
  CMD=(bash -lc "${BOOTSTRAP}exec \"\$@\"" agent-pod-exec "${CMD[@]}")
fi

info "agent-pod: running '$AGENT' in $PWD"
info "  state: $STATE_DIR"

exec docker run --rm \
