{
  "name": "@jchaselubitz/agent-pod",
  "version": "0.1.0",
  "description": "Run AI coding-agent CLIs inside a Docker sandbox scoped to the current project.",
  "author": "Jake Chase-Lubitz",
  "bin": {
    "agent-pod": "agent-pod"
