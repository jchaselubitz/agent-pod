# AgentPod config template. `agent-pod setup` copies this to ~/.agent-pod/.agent-pod.env.
# Set AGENT_POD_ENV_FILE explicitly when a project needs a different file.

# Overlord backend URL and user token (see https://ovld.ai/docs)
# Generate a token in Overlord Desktop: Settings > Tokens.
# Inside a pod, reach a host-local Desktop backend at host.docker.internal
# (include http:// — bare host:port works but http:// is clearer):
# OVERLORD_BACKEND_URL=http://host.docker.internal:4310
OVERLORD_BACKEND_URL=http://127.0.0.1:4310
OVERLORD_USER_TOKEN=

# Common agent provider keys. Claude Code prefers its saved OAuth token when set.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CURSOR_API_KEY=
ANTIGRAVITY_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Tooling/service keys agents often need while working in a project
GITHUB_TOKEN=
STRIPE_SECRET_KEY=

# Optional provider/project configuration
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=
ANTHROPIC_BASE_URL=

# Git identity for commits made inside the container
GIT_USER_EMAIL=
GIT_USER_NAME=

# AgentPod runtime configuration
# PORTS=3000,8080
# AGENT_POD_ENV=AWS_PROFILE,MY_API_URL
# AGENT_POD_IMAGE=agent-pod
# AGENT_POD_HOME=/path/to/state
# AGENT_POD_AGENTS=claude,codex,gemini

# Custom agent definitions (add your own agents/harnesses beyond the four built-ins).
# Include the agent ID in AGENT_POD_AGENTS, then define its CLI and optional flags/npm package:
# AGENT_POD_GEMINI_BIN=gemini
# AGENT_POD_GEMINI_FLAGS=--yolo
# AGENT_POD_GEMINI_NPM=@google/gemini-cli
#
# AGENT_POD_MY_HARNESS_BIN=my-harness-cli
# AGENT_POD_MY_HARNESS_FLAGS=--skip-permissions --force
# AGENT_POD_MY_HARNESS_NPM=my-harness-cli@latest

# Custom apt/npm packages baked into the sandbox image (space-separated lists).
# Use for shared tooling/libraries — not per-agent CLIs (see AGENT_POD_<ID>_NPM above).
# See: agent-pod protocol packages
#
# Prefer the CLI — it updates this file for you:
#   agent-pod package-add [--npm|--apt] <package> [package...]
#   agent-pod package-remove [--npm|--apt] <package> [package...]
#   agent-pod packages                              # show current lists
#
# Examples (--npm is the default):
#   agent-pod package-add --npm pnpm typescript
#   agent-pod package-add --npm @google/gemini-cli prettier@3
#   agent-pod package-add --apt python3 python3-pip build-essential
#
# Or set the keys below directly (space-separated for multiple packages), then rebuild:
#   agent-pod install-image       # first build or after config changes
#   agent-pod update-image        # refresh CLIs/packages without resetting auth
# AGENT_POD_NPM_PACKAGES=pnpm typescript prettier@3
# AGENT_POD_APT_PACKAGES=python3 python3-pip build-essential

# Allowlist extra host folders/files so pods can access paths outside the
# launch directory (e.g. a shared assets folder). Comma-separated, existing,
# absolute paths. Each is bind-mounted at the same absolute path in new pods,
# so the folder and all its children are visible. See:
#   agent-pod protocol files
#
# Entry format (same for every source): <absolute-path>[:rw|:ro]
#   - no suffix means :rw (read/write); append :ro for read-only
#   - whitespace around entries is trimmed: "/a:rw, /b:ro" is fine
#   - the launch directory is always mounted :rw; listing it (or marking it
#     :ro) is harmless — it can't be made read-only.
# Manage with: agent-pod file-access add|remove|list|clear <absolute-path[:ro]>
# AGENT_POD_ALLOWED_PATHS=/Users/me/assets:ro,/Users/me/src/shared-lib
#
# To share an allowlist with your team via git (this file and .agent-pod.env
# are both gitignored), commit a .agent-pod-allowed-paths file to the repo
# instead — see `agent-pod protocol files` or `agent-pod file-access add --project`.
#
# For automation that injects a one-off, task-specific path right before
# launch (e.g. Overlord) without touching the settings above: set
# AGENT_POD_EXTRA_ALLOWED_PATHS as an env var on that single launch. It's
# env-only (never read from or written to this file) and merges additively
# on top of everything else instead of replacing it. A service writing this
# value should put an explicit :rw/:ro on EVERY entry so the granted
# permission is self-documenting in the value and the startup log line.
#   AGENT_POD_EXTRA_ALLOWED_PATHS=/tmp/task-123-assets:ro agent-pod claude

# Shared package-manager caches. Each agent gets its own HOME under
# ~/.agent-pod/<agent>, which would otherwise give every agent its own copy of
# every npm/yarn/cargo/rust cache — the single biggest driver of AgentPod's disk
# usage. One shared copy of each cache below is mounted into every pod instead.
# Agent auth, history, and config (.claude, .codex, .config, .ovld, ...) are
# never shared. See: agent-pod protocol cache
#   agent-pod cache            inspect sizes and reclaimable space
#   agent-pod cache migrate    seed the shared cache from existing per-agent copies
#   agent-pod cache clean      delete the per-agent copies it replaced
# AGENT_POD_SHARE_CACHES=1
# AGENT_POD_SHARED_CACHES=.npm,.cache,.yarn,.cargo,.rustup,.bun,.deno,.local/share/pnpm
#
# .npm-global is not in that list on purpose: it is npm's install prefix, where
# an agent CLI writes when it updates itself, not a cache. Agent CLI versions
# come from the image — refresh them with `agent-pod update-image` — and the
# in-pod updaters are disabled so the two cannot drift. Set this to 1 if you
# want pods to self-update instead.
# AGENT_POD_AGENT_AUTOUPDATE=0
#
# Shared codex login. Codex stores its device-code (ChatGPT) tokens in
# ~/.codex/auth.json inside the per-agent HOME, so a login done in the `codex`
# pod would not apply to codex launched under any other agent name. With this
# on, one copy of ~/.codex lives in ~/.agent-pod/.shared-auth/ and is mounted
# into every pod: log in once, everywhere works. Set to 0 to give each agent
# its own codex login again. Note that codex shares config.toml and history
# through the same directory, and that ChatGPT refresh tokens rotate — two
# sessions refreshing at the same moment can still invalidate each other.
# AGENT_POD_SHARE_CODEX_AUTH=1
#
# Skip Claude Code's first-run onboarding when a credential is available.
# Claude Code decides whether to onboard — theme picker, then a browser OAuth
# login — from ~/.claude.json, not from whether it can already authenticate, so
# a pod holding a perfectly good CLAUDE_CODE_OAUTH_TOKEN still opens by asking
# you to log in, once per agent name. With this on, AgentPod marks onboarding
# complete in the pod's HOME so the token is used instead. Does nothing when no
# CLAUDE_CODE_OAUTH_TOKEN / ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN is set:
# without a credential you do need to log in. Set to 0 to onboard normally.
# AGENT_POD_CLAUDE_SKIP_ONBOARDING=1
#
# Opt-in reuse of the HOST's own caches (HOME-relative, optional :ro/:rw).
# Safe ONLY for stores whose contents are platform-neutral, such as npm's
# _cacache and yarn berry's cache. Do NOT list .cargo, .rustup, .cache, .bun or
# .npm-global when the host is macOS/Windows and the pod is linux — those hold
# binaries built for the host architecture that the pod cannot execute.
# AGENT_POD_HOST_CACHES=.npm,.yarn:ro

# Access to other Docker containers (e.g. a local Supabase stack). See:
#   agent-pod protocol docker
# Mount the host Docker socket so agents can run docker commands (privileged):
#   agent-pod docker-access on
# AGENT_POD_DOCKER_ACCESS=0
# Attach launched pods to a Docker network so they can reach containers by name:
#   agent-pod network supabase_network_myproject
# AGENT_POD_DOCKER_NETWORK=

# AgentPod autonomous flag choices
# Set a value to 0 to run that agent without AgentPod's default autonomous flag.
AGENT_POD_OVERLORD=1
AGENT_POD_CLAUDE_AUTO_FLAGS=1
AGENT_POD_CODEX_AUTO_FLAGS=1
AGENT_POD_OPENCODE_AUTO_FLAGS=0
AGENT_POD_CURSOR_AUTO_FLAGS=1
