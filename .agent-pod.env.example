# Copy this to .agent-pod.env and fill in only the values your agent needs.
# .agent-pod.env is ignored by git.

# Overlord agent token (see https://ovld.ai/docs/authentication/agent-token)
# When set, `agent-pod install-image` runs `ovld setup all` for each agent so
# the Overlord connectors and protocol permissions are ready to use.
OVERLORD_AGENT_TOKEN=

# Common agent provider keys (If connecting to agents via the provider's API)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CURSOR_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Tooling/service keys agents often need while working in a project
GITHUB_TOKEN=
STRIPE_SECRET_KEY=

# Optional provider/project configuration
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=
ANTHROPIC_BASE_URL=

# Git identity for commits made inside the container
GIT_USER_EMAIL=
GIT_USER_NAME=

# AgentPod runtime configuration
# PORTS=3000,8080
# AGENT_POD_ENV=AWS_PROFILE,MY_API_URL
# AGENT_POD_IMAGE=agent-pod
# AGENT_POD_HOME=/path/to/state

# AgentPod autonomous flag choices
# Set a value to 0 to run that agent without AgentPod's default autonomous flag.
AGENT_POD_CLAUDE_AUTO_FLAGS=1
AGENT_POD_CODEX_AUTO_FLAGS=1
AGENT_POD_OPENCODE_AUTO_FLAGS=0
AGENT_POD_OVERLORD_AUTO_FLAGS=0
AGENT_POD_CURSOR_AUTO_FLAGS=1
