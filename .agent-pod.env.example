# Copy this to .agent-pod.env and fill in only the values your agent needs.
# .agent-pod.env is ignored by git.

# Overlord backend URL and user token (see https://ovld.ai/docs)
# Generate a token in Overlord Desktop: Settings > Tokens.
# When both are set, `agent-pod install-image` runs `ovld agent-setup all` for
# each agent so the Overlord connectors and protocol permissions are ready to use.
OVERLORD_BACKEND_URL=http://127.0.0.1:4310
OVERLORD_USER_TOKEN=

# Common agent provider keys (If connecting to agents via the provider's API)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CURSOR_API_KEY=
ANTIGRAVITY_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Tooling/service keys agents often need while working in a project
GITHUB_TOKEN=
STRIPE_SECRET_KEY=

# Optional provider/project configuration
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=
ANTHROPIC_BASE_URL=

# Git identity for commits made inside the container
GIT_USER_EMAIL=
GIT_USER_NAME=

# AgentPod runtime configuration
# PORTS=3000,8080
# AGENT_POD_ENV=AWS_PROFILE,MY_API_URL
# AGENT_POD_IMAGE=agent-pod
# AGENT_POD_HOME=/path/to/state
# AGENT_POD_AGENTS=claude,codex,gemini

# Custom agent definitions (add your own agents/harnesses beyond the four built-ins).
# Include the agent ID in AGENT_POD_AGENTS, then define its CLI and optional flags/npm package:
# AGENT_POD_GEMINI_BIN=gemini
# AGENT_POD_GEMINI_FLAGS=--yolo
# AGENT_POD_GEMINI_NPM=@google/gemini-cli
#
# AGENT_POD_MY_HARNESS_BIN=my-harness-cli
# AGENT_POD_MY_HARNESS_FLAGS=--skip-permissions --force
# AGENT_POD_MY_HARNESS_NPM=my-harness-cli@latest

# Custom packages baked into the sandbox image at build time. Space-separated.
# Edit these directly, or manage them with:
#   agent-pod package-add --npm pnpm typescript
#   agent-pod package-add --apt python3 build-essential
# Rebuild after changing: agent-pod install-image
# AGENT_POD_NPM_PACKAGES=pnpm typescript
# AGENT_POD_APT_PACKAGES=python3 build-essential

# Access to other Docker containers (e.g. a local Supabase stack). See:
#   agent-pod protocol docker
# Mount the host Docker socket so agents can run docker commands (privileged):
#   agent-pod docker-access on
# AGENT_POD_DOCKER_ACCESS=0
# Attach launched pods to a Docker network so they can reach containers by name:
#   agent-pod network supabase_network_myproject
# AGENT_POD_DOCKER_NETWORK=

# AgentPod autonomous flag choices
# Set a value to 0 to run that agent without AgentPod's default autonomous flag.
AGENT_POD_CLAUDE_AUTO_FLAGS=1
AGENT_POD_CODEX_AUTO_FLAGS=1
AGENT_POD_OPENCODE_AUTO_FLAGS=0
AGENT_POD_OVERLORD_AUTO_FLAGS=0
AGENT_POD_CURSOR_AUTO_FLAGS=1
